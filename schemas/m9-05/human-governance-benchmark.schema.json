{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m9-05/human-governance-benchmark.schema.json",
  "title": "M9-05 human governance benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "generated_at", "parameters", "thresholds", "results", "latency_ms", "latency_samples_ms", "attestation", "gate", "provenance", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.human-governance-benchmark/v1alpha1"},
    "benchmark_id": {"const": "m9-05-human-governance"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "results": {"$ref": "#/$defs/results"},
    "latency_ms": {"$ref": "#/$defs/latency"},
    "latency_samples_ms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "attestation": {"$ref": "#/$defs/attestation"},
    "gate": {"$ref": "#/$defs/gate"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 4000},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "fixture", "latency_path"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
        "fixture": {"const": "m9-05-four-action-veto-matrix-v1"},
        "latency_path": {"const": "four-actions+state/audit-tamper+replay+project-scope"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["four_action_success_rate_min", "generic_bypass_rejection_rate_min", "session_denial_rate_min", "duplicate_replay_rate_min", "duplicate_drift_conflict_rate_min", "event_tamper_rejection_rate_min", "audit_binding_rejection_rate_min", "project_scope_rate_min", "invalid_input_rejection_rate_min", "denied_state_calls_max", "authority_violations_max", "provider_invocations_max", "external_services_max", "latency_p95_ms_max"],
      "properties": {
        "four_action_success_rate_min": {"const": 1.0},
        "generic_bypass_rejection_rate_min": {"const": 1.0},
        "session_denial_rate_min": {"const": 1.0},
        "duplicate_replay_rate_min": {"const": 1.0},
        "duplicate_drift_conflict_rate_min": {"const": 1.0},
        "event_tamper_rejection_rate_min": {"const": 1.0},
        "audit_binding_rejection_rate_min": {"const": 1.0},
        "project_scope_rate_min": {"const": 1.0},
        "invalid_input_rejection_rate_min": {"const": 1.0},
        "denied_state_calls_max": {"const": 0},
        "authority_violations_max": {"const": 0},
        "provider_invocations_max": {"const": 0},
        "external_services_max": {"const": 0},
        "latency_p95_ms_max": {"const": 50.0}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["four_action_successes", "four_action_success_rate", "generic_bypass_rejections", "generic_bypass_rejection_rate", "session_denials", "session_denial_rate", "duplicate_replays", "duplicate_replay_rate", "duplicate_drift_conflicts", "duplicate_drift_conflict_rate", "event_tamper_rejections", "event_tamper_rejection_rate", "audit_binding_rejections", "audit_binding_rejection_rate", "project_scope_matches", "project_scope_rate", "invalid_input_rejections", "invalid_input_rejection_rate", "denied_state_calls", "authority_violations", "provider_invocations", "external_services"],
      "properties": {
        "four_action_successes": {"$ref": "#/$defs/count"},
        "four_action_success_rate": {"$ref": "#/$defs/rate"},
        "generic_bypass_rejections": {"$ref": "#/$defs/count"},
        "generic_bypass_rejection_rate": {"$ref": "#/$defs/rate"},
        "session_denials": {"$ref": "#/$defs/count"},
        "session_denial_rate": {"$ref": "#/$defs/rate"},
        "duplicate_replays": {"$ref": "#/$defs/count"},
        "duplicate_replay_rate": {"$ref": "#/$defs/rate"},
        "duplicate_drift_conflicts": {"$ref": "#/$defs/count"},
        "duplicate_drift_conflict_rate": {"$ref": "#/$defs/rate"},
        "event_tamper_rejections": {"$ref": "#/$defs/count"},
        "event_tamper_rejection_rate": {"$ref": "#/$defs/rate"},
        "audit_binding_rejections": {"$ref": "#/$defs/count"},
        "audit_binding_rejection_rate": {"$ref": "#/$defs/rate"},
        "project_scope_matches": {"$ref": "#/$defs/count"},
        "project_scope_rate": {"$ref": "#/$defs/rate"},
        "invalid_input_rejections": {"$ref": "#/$defs/count"},
        "invalid_input_rejection_rate": {"$ref": "#/$defs/rate"},
        "denied_state_calls": {"const": 0},
        "authority_violations": {"const": 0},
        "provider_invocations": {"const": 0},
        "external_services": {"const": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p50", "p95", "max"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0},
        "p50": {"type": "number", "exclusiveMinimum": 0},
        "p95": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 50.0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "measurement_authenticity", "zero_count_source", "provider_probe_targets", "external_probe_targets"],
      "properties": {
        "mode": {"const": "local-unattested"},
        "measurement_authenticity": {"const": false},
        "zero_count_source": {"const": "isolated-effect-probe"},
        "provider_probe_targets": {"const": ["provider-skill-adapter", "recall-provider", "reviewer-adapter"]},
        "external_probe_targets": {"const": ["socket.connect", "socket.create_connection", "subprocess.Popen"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_gates"],
      "properties": {
        "status": {"const": "passed"},
        "failed_gates": {"type": "array", "maxItems": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256", "benchmark_sha256", "request_schema_sha256", "response_schema_sha256", "benchmark_schema_sha256", "state_mcp_sha256", "state_event_sha256", "authorization_audit_sha256", "authorization_audit_schema_sha256"],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "request_schema_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_schema_sha256": {"$ref": "#/$defs/sha256"},
        "state_mcp_sha256": {"$ref": "#/$defs/sha256"},
        "state_event_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_audit_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_audit_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
