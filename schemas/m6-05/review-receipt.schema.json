{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m6-05/review-receipt.schema.json",
  "title": "Reviewer Adapter Receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "request_id", "task_id", "execution_packet_ref", "artifact_refs", "max_output_bytes", "request_sha256", "provider_id", "provider_kind", "status", "operation_ref", "findings", "returned_bytes", "observed_at", "deadline_at", "async_degraded", "state_write_authority", "completion_authority", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.review-receipt/v1alpha1"}, "receipt_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"},
    "execution_packet_ref": {"$ref": "#/$defs/artifact"}, "artifact_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}, "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "request_sha256": {"$ref": "#/$defs/sha256"},
    "provider_kind": {"enum": ["local", "external"]}, "status": {"enum": ["completed", "pending", "timed_out"]}, "operation_ref": {"type": ["string", "null"], "maxLength": 256},
    "findings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/finding"}}, "returned_bytes": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"}, "deadline_at": {"type": "string", "format": "date-time"}, "async_degraded": {"type": "boolean"},
    "state_write_authority": {"const": false}, "completion_authority": {"const": false}, "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {"properties": {"operation_ref": {"type": "null"}, "async_degraded": {"const": false}}},
      "else": {"properties": {"operation_ref": {"type": "string", "minLength": 1, "maxLength": 256}, "findings": {"maxItems": 0}, "returned_bytes": {"const": 0}, "async_degraded": {"const": true}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "summary", "evidence_refs", "candidate_only"], "properties": {"finding_id": {"$ref": "#/$defs/id"}, "severity": {"enum": ["low", "medium", "high", "critical"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 8192}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}, "candidate_only": {"const": true}}}
  }
}
