{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m9-03/decision-evidence-benchmark.schema.json",
  "title": "Context Decision and Evidence Benchmark Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "generated_at",
    "parameters",
    "thresholds",
    "results",
    "latency_ms",
    "latency_samples_ms",
    "attestation",
    "gate",
    "provenance",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.decision-evidence-benchmark/v1alpha1"},
    "benchmark_id": {"const": "m9-03-decision-evidence"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "results": {"$ref": "#/$defs/results"},
    "latency_ms": {"$ref": "#/$defs/latency"},
    "latency_samples_ms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "attestation": {"$ref": "#/$defs/attestation"},
    "gate": {"$ref": "#/$defs/gate"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "latencyValue": {"type": "number", "minimum": 0},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "long_chain_items", "stress_matrix_side", "stress_matrix_cells", "max_evidence_references", "latency_path", "latency_gate_evaluated"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
        "long_chain_items": {"const": 128},
        "stress_matrix_side": {"const": 64},
        "stress_matrix_cells": {"const": 4096},
        "max_evidence_references": {"const": 50000},
        "latency_path": {"const": "max(baseline-validated,chain-128,matrix-4096,tamper-rebuild)"},
        "latency_gate_evaluated": {"type": "boolean"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_revision_rate_min",
        "decision_timeline_complete_rate_min",
        "constraint_matrix_complete_rate_min",
        "evidence_matrix_complete_rate_min",
        "current_decision_rate_min",
        "supersedes_chain_rate_min",
        "metadata_only_honesty_rate_min",
        "validated_provenance_rate_min",
        "evidence_classification_rate_min",
        "tamper_rejection_rate_min",
        "object_capacity_rejection_required",
        "reference_capacity_rejection_required",
        "false_supports_max",
        "old_decision_resurrections_max",
        "authority_violations_max",
        "provider_invocations_max",
        "external_services_max",
        "worst_path_latency_p95_ms_max"
      ],
      "properties": {
        "same_revision_rate_min": {"const": 1.0},
        "decision_timeline_complete_rate_min": {"const": 1.0},
        "constraint_matrix_complete_rate_min": {"const": 1.0},
        "evidence_matrix_complete_rate_min": {"const": 1.0},
        "current_decision_rate_min": {"const": 1.0},
        "supersedes_chain_rate_min": {"const": 1.0},
        "metadata_only_honesty_rate_min": {"const": 1.0},
        "validated_provenance_rate_min": {"const": 1.0},
        "evidence_classification_rate_min": {"const": 1.0},
        "tamper_rejection_rate_min": {"const": 1.0},
        "object_capacity_rejection_required": {"const": true},
        "reference_capacity_rejection_required": {"const": true},
        "false_supports_max": {"const": 0},
        "old_decision_resurrections_max": {"const": 0},
        "authority_violations_max": {"const": 0},
        "provider_invocations_max": {"const": 0},
        "external_services_max": {"const": 0},
        "worst_path_latency_p95_ms_max": {"const": 50.0}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_revision_matches",
        "decision_timeline_complete_matches",
        "constraint_matrix_complete_matches",
        "evidence_matrix_complete_matches",
        "current_decision_matches",
        "supersedes_chain_matches",
        "metadata_only_honesty_matches",
        "validated_provenance_matches",
        "evidence_classification_matches",
        "tamper_rejections",
        "same_revision_rate",
        "decision_timeline_complete_rate",
        "constraint_matrix_complete_rate",
        "evidence_matrix_complete_rate",
        "current_decision_rate",
        "supersedes_chain_rate",
        "metadata_only_honesty_rate",
        "validated_provenance_rate",
        "evidence_classification_rate",
        "tamper_rejection_rate",
        "object_capacity_rejected",
        "reference_capacity_rejected",
        "false_supports",
        "old_decision_resurrections",
        "authority_violations",
        "provider_invocations",
        "external_services"
      ],
      "properties": {
        "same_revision_matches": {"$ref": "#/$defs/count"},
        "decision_timeline_complete_matches": {"$ref": "#/$defs/count"},
        "constraint_matrix_complete_matches": {"$ref": "#/$defs/count"},
        "evidence_matrix_complete_matches": {"$ref": "#/$defs/count"},
        "current_decision_matches": {"$ref": "#/$defs/count"},
        "supersedes_chain_matches": {"$ref": "#/$defs/count"},
        "metadata_only_honesty_matches": {"$ref": "#/$defs/count"},
        "validated_provenance_matches": {"$ref": "#/$defs/count"},
        "evidence_classification_matches": {"$ref": "#/$defs/count"},
        "tamper_rejections": {"$ref": "#/$defs/count"},
        "same_revision_rate": {"const": 1.0},
        "decision_timeline_complete_rate": {"const": 1.0},
        "constraint_matrix_complete_rate": {"const": 1.0},
        "evidence_matrix_complete_rate": {"const": 1.0},
        "current_decision_rate": {"const": 1.0},
        "supersedes_chain_rate": {"const": 1.0},
        "metadata_only_honesty_rate": {"const": 1.0},
        "validated_provenance_rate": {"const": 1.0},
        "evidence_classification_rate": {"const": 1.0},
        "tamper_rejection_rate": {"const": 1.0},
        "object_capacity_rejected": {"const": true},
        "reference_capacity_rejected": {"const": true},
        "false_supports": {"const": 0},
        "old_decision_resurrections": {"const": 0},
        "authority_violations": {"const": 0},
        "provider_invocations": {"const": 0},
        "external_services": {"const": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p50", "p95", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/latencyValue"},
        "p50": {"$ref": "#/$defs/latencyValue"},
        "p95": {"type": "number", "minimum": 0},
        "max": {"$ref": "#/$defs/latencyValue"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "measurement_authenticity", "zero_count_source"],
      "properties": {
        "mode": {"const": "local-unattested"},
        "measurement_authenticity": {"const": false},
        "zero_count_source": {"const": "fixture-instrumentation"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_gates"],
      "properties": {
        "status": {"const": "passed"},
        "failed_gates": {"type": "array", "maxItems": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256", "benchmark_sha256", "external_state_provider_sha256", "typed_state_sha256", "assertion_provenance_sha256", "claim_evidence_gate_sha256", "retrieval_receipt_sha256"],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "external_state_provider_sha256": {"$ref": "#/$defs/sha256"},
        "typed_state_sha256": {"$ref": "#/$defs/sha256"},
        "assertion_provenance_sha256": {"$ref": "#/$defs/sha256"},
        "claim_evidence_gate_sha256": {"$ref": "#/$defs/sha256"},
        "retrieval_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
