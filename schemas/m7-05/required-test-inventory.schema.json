{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-05/required-test-inventory.schema.json",
  "title": "Context Control Plane Required Test Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "project_id", "repository_revision", "profile_id", "profile_sha256", "generated_at", "valid_until", "derivation", "tests", "state_write_authority", "completion_authority", "inventory_sha256"],
  "properties": {
    "schema_version": {"const": "context.required-test-inventory/v1alpha1"},
    "inventory_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "repository_revision": {"$ref": "#/$defs/revision"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "derivation": {"$ref": "#/$defs/inventoryDerivation"},
    "tests": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/test"}},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "inventory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "artifact": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "idList": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "gate_id", "node_ids", "always_run", "estimated_wall_time_ms", "estimated_input_bytes"],
      "properties": {"test_id": {"$ref": "#/$defs/id"}, "gate_id": {"$ref": "#/$defs/id"}, "node_ids": {"$ref": "#/$defs/idList"}, "always_run": {"type": "boolean"}, "estimated_wall_time_ms": {"type": "integer", "minimum": 1}, "estimated_input_bytes": {"type": "integer", "minimum": 1}},
      "if": {"properties": {"always_run": {"const": false}}, "required": ["always_run"]},
      "then": {"properties": {"node_ids": {"minItems": 1}}}
    },
    "inventoryDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "derivation_id", "subject_kind", "project_id", "repository_revision", "profile_id", "profile_sha256", "generated_at", "adapter_id", "adapter_version", "adapter_artifact_ref", "adapter_artifact_sha256", "config_artifact_ref", "config_artifact_sha256", "source_artifact_ref", "source_artifact_sha256", "dynamic_edge_artifact_ref", "dynamic_edge_artifact_sha256", "output_sha256", "state_write_authority", "completion_authority", "receipt_sha256"],
      "properties": {
        "schema_version": {"const": "context.deterministic-derivation-receipt/v1alpha1"},
        "derivation_id": {"$ref": "#/$defs/id"},
        "subject_kind": {"const": "required-test-inventory"},
        "project_id": {"$ref": "#/$defs/id"},
        "repository_revision": {"$ref": "#/$defs/revision"},
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "generated_at": {"type": "string", "format": "date-time"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "adapter_version": {"type": "string", "minLength": 5, "maxLength": 128},
        "adapter_artifact_ref": {"$ref": "#/$defs/artifact"},
        "adapter_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "config_artifact_ref": {"$ref": "#/$defs/artifact"},
        "config_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_artifact_ref": {"$ref": "#/$defs/artifact"},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "dynamic_edge_artifact_ref": {"type": "null"},
        "dynamic_edge_artifact_sha256": {"type": "null"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "state_write_authority": {"const": false},
        "completion_authority": {"const": false},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
