{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-05/affected-test-selection-benchmark.schema.json",
  "title": "Context Control Plane Affected-Test Selection Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "iterations", "fixture_id", "fixture_sha256", "golden_id", "golden_sha256", "scenario_counts", "selection_mode_counts", "missed_test_count", "unsafe_partial_selection_count", "fallback_mismatch_count", "replay_mismatch_count", "micro_baseline_test_ids", "micro_selected_test_ids", "micro_wall_time_ns_samples", "micro_processed_bytes", "micro_workload_outputs", "micro_baseline_wall_time_ns", "micro_selected_wall_time_ns", "micro_wall_time_reduction_basis_points", "micro_bytes_reduction_basis_points", "micro_workload_outputs_sha256", "real_baseline_test_ids", "real_selected_test_ids", "real_command_receipts", "real_baseline_wall_time_ns", "real_selected_wall_time_ns", "real_wall_time_reduction_basis_points", "real_command_missed_count", "environment", "external_service_calls", "state_write_authority_count", "completion_authority_count", "benchmark_sha256"],
  "properties": {
    "schema_version": {"const": "context.affected-test-selection-benchmark/v1alpha1"},
    "iterations": {"type": "integer", "minimum": 8, "maximum": 100000},
    "fixture_id": {"$ref": "#/$defs/id"},
    "fixture_sha256": {"$ref": "#/$defs/sha256"},
    "golden_id": {"$ref": "#/$defs/id"},
    "golden_sha256": {"$ref": "#/$defs/sha256"},
    "scenario_counts": {"type": "object", "minProperties": 8, "maxProperties": 8, "additionalProperties": {"type": "integer", "minimum": 0}},
    "selection_mode_counts": {"type": "object", "additionalProperties": false, "properties": {"selected": {"type": "integer", "minimum": 0}, "full-validation": {"type": "integer", "minimum": 0}}},
    "missed_test_count": {"const": 0},
    "unsafe_partial_selection_count": {"const": 0},
    "fallback_mismatch_count": {"const": 0},
    "replay_mismatch_count": {"const": 0},
    "micro_baseline_test_ids": {"$ref": "#/$defs/idList"},
    "micro_selected_test_ids": {"$ref": "#/$defs/idList"},
    "micro_wall_time_ns_samples": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}}},
    "micro_processed_bytes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "micro_workload_outputs": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "micro_baseline_wall_time_ns": {"type": "integer", "minimum": 1},
    "micro_selected_wall_time_ns": {"type": "integer", "minimum": 1},
    "micro_wall_time_reduction_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "micro_bytes_reduction_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "micro_workload_outputs_sha256": {"$ref": "#/$defs/sha256"},
    "real_baseline_test_ids": {"$ref": "#/$defs/idList"},
    "real_selected_test_ids": {"$ref": "#/$defs/idList"},
    "real_command_receipts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/commandReceipt"}},
    "real_baseline_wall_time_ns": {"type": "integer", "minimum": 1},
    "real_selected_wall_time_ns": {"type": "integer", "minimum": 1},
    "real_wall_time_reduction_basis_points": {"type": "integer", "minimum": 3000, "maximum": 10000},
    "real_command_missed_count": {"const": 0},
    "environment": {"$ref": "#/$defs/environment"},
    "external_service_calls": {"const": 0},
    "state_write_authority_count": {"const": 0},
    "completion_authority_count": {"const": 0},
    "benchmark_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idList": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "commandReceipt": {"type": "object", "additionalProperties": false, "required": ["test_id", "argv", "cwd", "exit_codes", "wall_time_ns_samples", "stdout_sha256_samples", "stderr_sha256_samples"], "properties": {"test_id": {"$ref": "#/$defs/id"}, "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "cwd": {"const": "repository-root"}, "exit_codes": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"const": 0}}, "wall_time_ns_samples": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "integer", "minimum": 1}}, "stdout_sha256_samples": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/sha256"}}, "stderr_sha256_samples": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/sha256"}}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["python_implementation", "python_version", "platform_system", "platform_machine", "repository_tree_sha256", "command_catalog_sha256", "timing_clock"], "properties": {"python_implementation": {"type": "string", "minLength": 1}, "python_version": {"type": "string", "minLength": 1}, "platform_system": {"type": "string", "minLength": 1}, "platform_machine": {"type": "string", "minLength": 1}, "repository_tree_sha256": {"$ref": "#/$defs/sha256"}, "command_catalog_sha256": {"$ref": "#/$defs/sha256"}, "timing_clock": {"const": "perf_counter_ns"}}}
  }
}
