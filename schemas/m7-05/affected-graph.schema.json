{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-05/affected-graph.schema.json",
  "title": "Context Control Plane Affected Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "project_id", "repository_revision", "profile_id", "profile_sha256", "generated_at", "valid_until", "derivation", "completeness", "dynamic_edge_status", "nodes", "state_write_authority", "completion_authority", "graph_sha256"],
  "properties": {
    "schema_version": {"const": "context.affected-graph/v1alpha1"},
    "graph_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "repository_revision": {"$ref": "#/$defs/revision"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "derivation": {"$ref": "#/$defs/graphDerivation"},
    "completeness": {"enum": ["complete", "incomplete", "unknown"]},
    "dynamic_edge_status": {"enum": ["none", "resolved", "present", "unknown"]},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/node"}},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "graph_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "artifact": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "idList": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "pathList": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//).+$"}},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "path_prefixes", "depends_on_node_ids"],
      "properties": {"node_id": {"$ref": "#/$defs/id"}, "path_prefixes": {"$ref": "#/$defs/pathList"}, "depends_on_node_ids": {"$ref": "#/$defs/idList"}}
    },
    "graphDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "derivation_id", "subject_kind", "project_id", "repository_revision", "profile_id", "profile_sha256", "generated_at", "adapter_id", "adapter_version", "adapter_artifact_ref", "adapter_artifact_sha256", "config_artifact_ref", "config_artifact_sha256", "source_artifact_ref", "source_artifact_sha256", "dynamic_edge_artifact_ref", "dynamic_edge_artifact_sha256", "output_sha256", "state_write_authority", "completion_authority", "receipt_sha256"],
      "properties": {
        "schema_version": {"const": "context.deterministic-derivation-receipt/v1alpha1"},
        "derivation_id": {"$ref": "#/$defs/id"},
        "subject_kind": {"const": "affected-graph"},
        "project_id": {"$ref": "#/$defs/id"},
        "repository_revision": {"$ref": "#/$defs/revision"},
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "generated_at": {"type": "string", "format": "date-time"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "adapter_version": {"type": "string", "minLength": 5, "maxLength": 128},
        "adapter_artifact_ref": {"$ref": "#/$defs/artifact"},
        "adapter_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "config_artifact_ref": {"$ref": "#/$defs/artifact"},
        "config_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_artifact_ref": {"$ref": "#/$defs/artifact"},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "dynamic_edge_artifact_ref": {"$ref": "#/$defs/artifact"},
        "dynamic_edge_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "state_write_authority": {"const": false},
        "completion_authority": {"const": false},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
