{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-05/affected-test-selection-fixture.schema.json",
  "title": "Context Control Plane Affected-Test Selection Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "golden_id", "golden_sha256", "project_revision", "repository_revision", "evaluated_at", "profile", "artifacts", "contexts", "inventory", "graphs", "change_sets", "micro_workload", "state_write_authority", "completion_authority", "fixture_sha256"],
  "properties": {
    "schema_version": {"const": "context.affected-test-selection-fixture/v1alpha1"},
    "fixture_id": {"$ref": "#/$defs/id"},
    "golden_id": {"$ref": "#/$defs/id"},
    "golden_sha256": {"$ref": "#/$defs/sha256"},
    "project_revision": {"type": "integer", "minimum": 0},
    "repository_revision": {"$ref": "#/$defs/revision"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "profile": {"type": "object", "minProperties": 1},
    "artifacts": {"type": "object", "minProperties": 1, "maxProperties": 1024, "patternProperties": {"^artifact://sha256/[0-9a-f]{64}$": {"type": "string", "maxLength": 1048576}}, "additionalProperties": false},
    "contexts": {"type": "object", "additionalProperties": false, "required": ["current", "dynamic"], "properties": {"current": {"type": "object"}, "dynamic": {"type": "object"}}},
    "inventory": {"type": "object", "minProperties": 1},
    "graphs": {"type": "object", "additionalProperties": false, "required": ["current", "dynamic", "incomplete", "stale"], "properties": {"current": {"type": "object"}, "dynamic": {"type": "object"}, "incomplete": {"type": "object"}, "stale": {"type": "object"}}},
    "change_sets": {"type": "object", "minProperties": 8, "maxProperties": 64, "additionalProperties": {"type": "object"}},
    "micro_workload": {"$ref": "#/$defs/workload"},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "fixture_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "workload": {"type": "object", "additionalProperties": false, "required": ["payload_size_bytes", "repetitions_per_test"], "properties": {"payload_size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "repetitions_per_test": {"type": "integer", "minimum": 1, "maximum": 4096}}}
  }
}
