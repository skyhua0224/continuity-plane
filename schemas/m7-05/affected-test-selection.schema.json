{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-05/affected-test-selection.schema.json",
  "title": "Context Control Plane Affected Test Selection Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "work_id", "project_id", "project_revision", "repository_revision", "change_set_id", "change_set_sha256", "profile_id", "profile_sha256", "inventory_id", "inventory_sha256", "graph_id", "graph_sha256", "evaluated_at", "changed_paths", "selection_mode", "fallback_reasons", "affected_node_ids", "full_test_ids", "selected_test_ids", "required_gate_ids", "baseline_estimated_wall_time_ms", "selected_estimated_wall_time_ms", "baseline_input_bytes", "selected_input_bytes", "wall_time_reduction_basis_points", "input_bytes_reduction_basis_points", "external_service_calls", "state_write_authority", "completion_authority", "input_sha256", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.affected-test-selection/v1alpha1"},
    "selection_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"type": "integer", "minimum": 0},
    "repository_revision": {"$ref": "#/$defs/revision"},
    "change_set_id": {"$ref": "#/$defs/id"},
    "change_set_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_id": {"$ref": "#/$defs/id"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "graph_id": {"$ref": "#/$defs/id"},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "changed_paths": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "selection_mode": {"enum": ["selected", "full-validation"]},
    "fallback_reasons": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"enum": ["changed-path-unmapped", "dynamic-edges-present", "dynamic-edges-unknown", "graph-incomplete", "graph-profile-mismatch", "graph-project-mismatch", "graph-provenance-digest-mismatch", "graph-provenance-unavailable", "graph-repository-revision-mismatch", "graph-stale", "inventory-node-unmapped", "required-gate-uncovered"]}},
    "affected_node_ids": {"$ref": "#/$defs/idList"},
    "full_test_ids": {"allOf": [{"$ref": "#/$defs/idList"}, {"minItems": 1}]},
    "selected_test_ids": {"allOf": [{"$ref": "#/$defs/idList"}, {"minItems": 1}]},
    "required_gate_ids": {"allOf": [{"$ref": "#/$defs/idList"}, {"minItems": 1}]},
    "baseline_estimated_wall_time_ms": {"type": "integer", "minimum": 1},
    "selected_estimated_wall_time_ms": {"type": "integer", "minimum": 1},
    "baseline_input_bytes": {"type": "integer", "minimum": 1},
    "selected_input_bytes": {"type": "integer", "minimum": 1},
    "wall_time_reduction_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "input_bytes_reduction_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "external_service_calls": {"const": 0},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"selection_mode": {"const": "selected"}}, "required": ["selection_mode"]}, "then": {"properties": {"fallback_reasons": {"maxItems": 0}, "affected_node_ids": {"minItems": 1}}}},
    {"if": {"properties": {"selection_mode": {"const": "full-validation"}}, "required": ["selection_mode"]}, "then": {"properties": {"fallback_reasons": {"minItems": 1}, "affected_node_ids": {"maxItems": 0}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "idList": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//).+$"}
  }
}
