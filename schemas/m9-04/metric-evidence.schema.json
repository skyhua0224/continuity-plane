{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m9-04/metric-evidence.schema.json",
  "title": "Context Accounting Metric Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "accounting_id",
    "accounting_sha256",
    "corpus_id",
    "corpus_sha256",
    "route_id",
    "provider_id",
    "trace_event_id",
    "run_id",
    "observed_at",
    "metrics",
    "state_write_authority",
    "provider_native_authority",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.metric-evidence/v1alpha1"},
    "evidence_id": {"$ref": "#/$defs/id"},
    "accounting_id": {"$ref": "#/$defs/id"},
    "accounting_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "route_id": {"$ref": "#/$defs/id"},
    "provider_id": {"$ref": "#/$defs/id"},
    "trace_event_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "observed_at": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "enum": [
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_write_tokens",
          "billing_usd_micros",
          "retrieval_queries",
          "retrieval_read_bytes",
          "retrieval_output_bytes",
          "retrieval_latency_ms",
          "compaction_latency_ms",
          "cut_point_tokens",
          "cache_invalidated"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/metric"}
    },
    "state_write_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "source_kind"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "boolean"}
          ]
        },
        "unit": {
          "enum": ["tokens", "usd_micros", "count", "bytes", "milliseconds", "boolean"]
        },
        "source_kind": {
          "enum": ["provider_trace", "retrieval_receipt", "monotonic_clock", "host_hook"]
        }
      }
    }
  }
}
