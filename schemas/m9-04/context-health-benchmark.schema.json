{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m9-04/context-health-benchmark.schema.json",
  "title": "Context Health Projection Benchmark Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "generated_at", "parameters", "thresholds", "results", "latency_ms", "latency_samples_ms", "scale_latency_ms", "scale_latency_samples_ms", "attestation", "gate", "provenance", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.context-health-benchmark/v1alpha1"},
    "benchmark_id": {"const": "m9-04-context-health"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "results": {"$ref": "#/$defs/results"},
    "latency_ms": {"$ref": "#/$defs/latency"},
    "latency_samples_ms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "scale_latency_ms": {"$ref": "#/$defs/scaleLatency"},
    "scale_latency_samples_ms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "attestation": {"$ref": "#/$defs/attestation"},
    "gate": {"$ref": "#/$defs/gate"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "fixture", "latency_path", "scale_trace_events", "scale_iterations"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
        "fixture": {"const": "m9-04-veto-matrix-scale-v2"},
        "latency_path": {"const": "scale-build+source-bound-rebuild+coordinated-tamper"},
        "scale_trace_events": {"const": 3500},
        "scale_iterations": {"type": "integer", "minimum": 1, "maximum": 25}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_revision_rate_min", "source_binding_rate_min", "context_binding_rate_min", "stale_assertion_visibility_rate_min", "harness_failure_visibility_rate_min", "replay_failure_visibility_rate_min", "unavailable_measurement_honesty_rate_min", "tamper_rejection_rate_min", "expired_claim_rejections_rate_min", "reference_conflict_rejections_rate_min", "terminal_digest_rejections_rate_min", "partial_accounting_honesty_rate_min", "read_budget_classification_rate_min", "acknowledged_input_replay_classification_rate_min", "metric_evidence_rejections_rate_min", "canary_tamper_rejections_rate_min", "effect_watermark_rejections_rate_min", "capacity_rejection_required", "false_healthy_claims_max", "false_current_assertions_max", "authority_violations_max", "provider_invocations_max", "external_services_max", "operational_latency_p95_ms_max", "worst_path_latency_p95_ms_max"],
      "properties": {
        "same_revision_rate_min": {"const": 1.0},
        "source_binding_rate_min": {"const": 1.0},
        "context_binding_rate_min": {"const": 1.0},
        "stale_assertion_visibility_rate_min": {"const": 1.0},
        "harness_failure_visibility_rate_min": {"const": 1.0},
        "replay_failure_visibility_rate_min": {"const": 1.0},
        "unavailable_measurement_honesty_rate_min": {"const": 1.0},
        "tamper_rejection_rate_min": {"const": 1.0},
        "expired_claim_rejections_rate_min": {"const": 1.0},
        "reference_conflict_rejections_rate_min": {"const": 1.0},
        "terminal_digest_rejections_rate_min": {"const": 1.0},
        "partial_accounting_honesty_rate_min": {"const": 1.0},
        "read_budget_classification_rate_min": {"const": 1.0},
        "acknowledged_input_replay_classification_rate_min": {"const": 1.0},
        "metric_evidence_rejections_rate_min": {"const": 1.0},
        "canary_tamper_rejections_rate_min": {"const": 1.0},
        "effect_watermark_rejections_rate_min": {"const": 1.0},
        "capacity_rejection_required": {"const": true},
        "false_healthy_claims_max": {"const": 0},
        "false_current_assertions_max": {"const": 0},
        "authority_violations_max": {"const": 0},
        "provider_invocations_max": {"const": 0},
        "external_services_max": {"const": 0},
        "operational_latency_p95_ms_max": {"const": 50.0},
        "worst_path_latency_p95_ms_max": {"const": 500.0}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_revision_matches", "source_binding_matches", "context_binding_matches", "stale_assertion_visibility_matches", "harness_failure_visibility_matches", "replay_failure_visibility_matches", "unavailable_measurement_honesty_matches", "tamper_rejections", "expired_claim_rejections", "reference_conflict_rejections", "terminal_digest_rejections", "partial_accounting_honesty_matches", "read_budget_classification_matches", "acknowledged_input_replay_classification_matches", "metric_evidence_rejections", "canary_tamper_rejections", "effect_watermark_rejections", "same_revision_rate", "source_binding_rate", "context_binding_rate", "stale_assertion_visibility_rate", "harness_failure_visibility_rate", "replay_failure_visibility_rate", "unavailable_measurement_honesty_rate", "tamper_rejections_rate", "expired_claim_rejections_rate", "reference_conflict_rejections_rate", "terminal_digest_rejections_rate", "partial_accounting_honesty_rate", "read_budget_classification_rate", "acknowledged_input_replay_classification_rate", "metric_evidence_rejections_rate", "canary_tamper_rejections_rate", "effect_watermark_rejections_rate", "capacity_rejected", "capacity_cases_rejected", "capacity_cases_total", "false_healthy_claims", "false_current_assertions", "authority_violations", "provider_invocations", "external_services"],
      "properties": {
        "same_revision_matches": {"$ref": "#/$defs/count"},
        "source_binding_matches": {"$ref": "#/$defs/count"},
        "context_binding_matches": {"$ref": "#/$defs/count"},
        "stale_assertion_visibility_matches": {"$ref": "#/$defs/count"},
        "harness_failure_visibility_matches": {"$ref": "#/$defs/count"},
        "replay_failure_visibility_matches": {"$ref": "#/$defs/count"},
        "unavailable_measurement_honesty_matches": {"$ref": "#/$defs/count"},
        "tamper_rejections": {"$ref": "#/$defs/count"},
        "expired_claim_rejections": {"$ref": "#/$defs/count"},
        "reference_conflict_rejections": {"$ref": "#/$defs/count"},
        "terminal_digest_rejections": {"$ref": "#/$defs/count"},
        "partial_accounting_honesty_matches": {"$ref": "#/$defs/count"},
        "read_budget_classification_matches": {"$ref": "#/$defs/count"},
        "acknowledged_input_replay_classification_matches": {"$ref": "#/$defs/count"},
        "metric_evidence_rejections": {"$ref": "#/$defs/count"},
        "canary_tamper_rejections": {"$ref": "#/$defs/count"},
        "effect_watermark_rejections": {"$ref": "#/$defs/count"},
        "same_revision_rate": {"$ref": "#/$defs/rate"},
        "source_binding_rate": {"$ref": "#/$defs/rate"},
        "context_binding_rate": {"$ref": "#/$defs/rate"},
        "stale_assertion_visibility_rate": {"$ref": "#/$defs/rate"},
        "harness_failure_visibility_rate": {"$ref": "#/$defs/rate"},
        "replay_failure_visibility_rate": {"$ref": "#/$defs/rate"},
        "unavailable_measurement_honesty_rate": {"$ref": "#/$defs/rate"},
        "tamper_rejections_rate": {"$ref": "#/$defs/rate"},
        "expired_claim_rejections_rate": {"$ref": "#/$defs/rate"},
        "reference_conflict_rejections_rate": {"$ref": "#/$defs/rate"},
        "terminal_digest_rejections_rate": {"$ref": "#/$defs/rate"},
        "partial_accounting_honesty_rate": {"$ref": "#/$defs/rate"},
        "read_budget_classification_rate": {"$ref": "#/$defs/rate"},
        "acknowledged_input_replay_classification_rate": {"$ref": "#/$defs/rate"},
        "metric_evidence_rejections_rate": {"$ref": "#/$defs/rate"},
        "canary_tamper_rejections_rate": {"$ref": "#/$defs/rate"},
        "effect_watermark_rejections_rate": {"$ref": "#/$defs/rate"},
        "capacity_rejected": {"const": true},
        "capacity_cases_rejected": {"const": 11},
        "capacity_cases_total": {"const": 11},
        "false_healthy_claims": {"const": 0},
        "false_current_assertions": {"const": 0},
        "authority_violations": {"const": 0},
        "provider_invocations": {"const": 0},
        "external_services": {"const": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p50", "p95", "max"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0},
        "p50": {"type": "number", "exclusiveMinimum": 0},
        "p95": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 50.0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "scaleLatency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p50", "p95", "max"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0},
        "p50": {"type": "number", "exclusiveMinimum": 0},
        "p95": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 500.0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "measurement_authenticity", "zero_count_source", "provider_probe_targets", "external_probe_targets"],
      "properties": {
        "mode": {"const": "local-unattested"},
        "measurement_authenticity": {"const": false},
        "zero_count_source": {"const": "isolated-effect-probe"},
        "provider_probe_targets": {
          "const": ["provider-skill-adapter", "recall-provider", "reviewer-adapter"]
        },
        "external_probe_targets": {
          "const": ["socket.connect", "socket.create_connection", "subprocess.Popen"]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_gates"],
      "properties": {
        "status": {"const": "passed"},
        "failed_gates": {"type": "array", "maxItems": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256", "benchmark_sha256", "fixture_sha256", "schema_sha256", "metric_evidence_implementation_sha256", "metric_evidence_schema_sha256", "projection_sha256"],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "metric_evidence_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "metric_evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
