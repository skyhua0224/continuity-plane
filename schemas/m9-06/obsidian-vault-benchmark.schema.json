{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m9-06/obsidian-vault-benchmark.schema.json",
  "title": "M9-06 generated Obsidian vault benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "generated_at",
    "parameters",
    "thresholds",
    "results",
    "latency_ms",
    "latency_samples_ms",
    "attestation",
    "gate",
    "provenance",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.obsidian-vault-benchmark/v1alpha1"},
    "benchmark_id": {"const": "m9-06-obsidian-vault"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "results": {"$ref": "#/$defs/results"},
    "latency_ms": {"$ref": "#/$defs/latency"},
    "latency_samples_ms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "attestation": {"$ref": "#/$defs/attestation"},
    "gate": {"$ref": "#/$defs/gate"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "file_count", "max_file_bytes"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
        "file_count": {"const": 4},
        "max_file_bytes": {"const": 4194304}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_validate_success_rate_min",
        "source_binding_rejection_rate_min",
        "generated_file_tamper_rejection_rate_min",
        "manifest_tamper_rejection_rate_min",
        "unmanaged_file_rejection_rate_min",
        "overwrite_rejection_rate_min",
        "authority_violations_max",
        "provider_invocations_max",
        "external_services_max",
        "latency_p95_ms_max"
      ],
      "properties": {
        "build_validate_success_rate_min": {"const": 1.0},
        "source_binding_rejection_rate_min": {"const": 1.0},
        "generated_file_tamper_rejection_rate_min": {"const": 1.0},
        "manifest_tamper_rejection_rate_min": {"const": 1.0},
        "unmanaged_file_rejection_rate_min": {"const": 1.0},
        "overwrite_rejection_rate_min": {"const": 1.0},
        "authority_violations_max": {"const": 0},
        "provider_invocations_max": {"const": 0},
        "external_services_max": {"const": 0},
        "latency_p95_ms_max": {"const": 50.0}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_validate_successes",
        "build_validate_success_rate",
        "source_binding_rejections",
        "source_binding_rejection_rate",
        "generated_file_tamper_rejections",
        "generated_file_tamper_rejection_rate",
        "manifest_tamper_rejections",
        "manifest_tamper_rejection_rate",
        "unmanaged_file_rejections",
        "unmanaged_file_rejection_rate",
        "overwrite_rejections",
        "overwrite_rejection_rate",
        "authority_violations",
        "provider_invocations",
        "external_services"
      ],
      "properties": {
        "build_validate_successes": {"type": "integer", "minimum": 0, "maximum": 1000},
        "build_validate_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "source_binding_rejections": {"type": "integer", "minimum": 0, "maximum": 1000},
        "source_binding_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "generated_file_tamper_rejections": {"type": "integer", "minimum": 0, "maximum": 1000},
        "generated_file_tamper_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "manifest_tamper_rejections": {"type": "integer", "minimum": 0, "maximum": 1000},
        "manifest_tamper_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "unmanaged_file_rejections": {"type": "integer", "minimum": 0, "maximum": 1000},
        "unmanaged_file_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "overwrite_rejections": {"type": "integer", "minimum": 0, "maximum": 1000},
        "overwrite_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "authority_violations": {"type": "integer", "minimum": 0},
        "provider_invocations": {"type": "integer", "minimum": 0},
        "external_services": {"type": "integer", "minimum": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "max"],
      "properties": {
        "p50": {"type": "number", "exclusiveMinimum": 0},
        "p95": {"type": "number", "exclusiveMinimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_write_authority",
        "completion_authority",
        "approval_authority",
        "provider_native_authority",
        "external_effect_authority",
        "local_filesystem_only"
      ],
      "properties": {
        "state_write_authority": {"const": false},
        "completion_authority": {"const": false},
        "approval_authority": {"const": false},
        "provider_native_authority": {"const": false},
        "external_effect_authority": {"const": false},
        "local_filesystem_only": {"const": true}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_gates"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "failed_gates": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_sha256",
        "benchmark_sha256",
        "vault_schema_sha256"
      ],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "vault_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
