{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.authorization-policy/v1alpha1",
  "title": "Context Control Plane authorization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_revision",
    "issued_at",
    "expires_at",
    "projects",
    "grants"
  ],
  "properties": {
    "schema_version": {
      "const": "context.authorization-policy/v1alpha1"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "grants": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "$ref": "#/$defs/grant"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "status"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/identifier"
        },
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "active",
            "disabled"
          ]
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "authorization_ref",
        "subject_ref",
        "tenant_id",
        "project_ids",
        "actions",
        "not_before",
        "expires_at",
        "status"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/identifier"
        },
        "authorization_ref": {
          "$ref": "#/$defs/identifier"
        },
        "subject_ref": {
          "$ref": "#/$defs/identifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/identifier"
        },
        "project_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        }
      }
    }
  }
}
