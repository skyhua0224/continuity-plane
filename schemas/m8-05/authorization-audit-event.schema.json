{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.authorization-audit-event/v1alpha1",
  "title": "Context Control Plane authorization audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "sequence_no",
    "policy_id",
    "policy_revision",
    "policy_sha256",
    "authorization_ref",
    "subject_ref",
    "subject_tenant_id",
    "tenant_id",
    "project_id",
    "action",
    "decision",
    "reason_code",
    "observed_at",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "context.authorization-audit-event/v1alpha1"
    },
    "event_type": {
      "const": "authorization_decision"
    },
    "event_id": {
      "$ref": "#/$defs/identifier"
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 1
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization_ref": {
      "$ref": "#/$defs/identifier"
    },
    "subject_ref": {
      "$ref": "#/$defs/identifier"
    },
    "subject_tenant_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "tenant_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "action": {
      "$ref": "#/$defs/identifier"
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "reason_code": {
      "enum": [
        "grant_matched",
        "policy_expired",
        "grant_not_found",
        "subject_mismatch",
        "grant_revoked",
        "grant_not_active",
        "grant_expired",
        "project_not_registered",
        "project_disabled",
        "tenant_mismatch",
        "project_not_granted",
        "action_not_granted"
      ]
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "previous_event_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allow"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "grant_matched"
          }
        }
      },
      "else": {
        "properties": {
          "reason_code": {
            "not": {
              "const": "grant_matched"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
