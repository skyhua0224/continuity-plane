{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-03/verification-run-receipt.schema.json",
  "title": "Context Control Plane Verification Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "work_id", "project_id", "project_revision", "repository_revision", "profile_id", "profile_sha256", "adapter_id", "adapter_sha256", "gate_id", "gate_kind", "invocation_sha256", "status", "started_at", "completed_at", "evidence_steps", "measurements", "state_write_authority", "completion_authority", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.verification-run-receipt/v1alpha1"},
    "run_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"type": "integer", "minimum": 0},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "adapter_sha256": {"$ref": "#/$defs/sha256"},
    "gate_id": {"$ref": "#/$defs/id"},
    "gate_kind": {"enum": ["static", "tdd", "build", "contract", "golden", "mutation", "loopback", "weak-network", "live", "performance", "fault-recovery"]},
    "invocation_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["passed", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "evidence_steps": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/step"}},
    "measurements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/measurement"}},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step": {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "artifact_ref", "artifact_sha256"], "properties": {"kind": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "artifact_ref": {"type": "string", "minLength": 1, "maxLength": 512}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["metric", "value", "unit"], "properties": {"metric": {"$ref": "#/$defs/id"}, "value": {"type": "integer", "minimum": 0}, "unit": {"enum": ["basis-points", "milliseconds", "bytes-per-second", "count"]}}}
  }
}
