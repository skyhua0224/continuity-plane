{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-03/verification-decision.schema.json",
  "title": "Context Control Plane Verification Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "work_id", "project_id", "project_revision", "profile_id", "profile_sha256", "adapter_id", "adapter_sha256", "gate_outcomes", "overall_status", "evaluated_at", "state_write_authority", "completion_authority", "decision_sha256"],
  "properties": {
    "schema_version": {"const": "context.verification-decision/v1alpha1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"type": "integer", "minimum": 0},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "adapter_sha256": {"$ref": "#/$defs/sha256"},
    "gate_outcomes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/outcome"}},
    "overall_status": {"enum": ["satisfied", "failed", "blocked"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idList": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "gate_kind", "mode", "status", "reason", "non_blocking", "condition_ref", "capability_refs", "run_receipt_sha256", "evidence_refs"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/id"},
        "gate_kind": {"enum": ["static", "tdd", "build", "contract", "golden", "mutation", "loopback", "weak-network", "live", "performance", "fault-recovery"]},
        "mode": {"enum": ["required", "conditional", "optional"]},
        "status": {"enum": ["satisfied", "failed", "blocked", "skipped"]},
        "reason": {"enum": ["gate-satisfied", "run-failed", "threshold-not-met", "condition-not-met", "condition-unknown", "capability-unavailable", "missing-run", "optional-not-run", "dependency-unsatisfied"]},
        "non_blocking": {"type": "boolean"},
        "condition_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
        "capability_refs": {"allOf": [{"$ref": "#/$defs/idList"}, {"minItems": 1}]},
        "run_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evidence_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    }
  }
}
