{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-03/verification-adapter.schema.json",
  "title": "Context Control Plane Verification Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "adapter_version", "project_id", "profile_id", "profile_sha256", "bindings", "state_write_authority", "completion_authority", "adapter_sha256"],
  "properties": {
    "schema_version": {"const": "context.verification-adapter/v1alpha1"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "adapter_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "project_id": {"$ref": "#/$defs/id"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/binding"}},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "adapter_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": ".*\\S.*"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "runner_kind", "executable", "arguments", "working_directory_ref", "environment_refs", "timeout_ms", "output_budget_bytes", "invocation_sha256"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/id"},
        "runner_kind": {"enum": ["local-process", "project-tool", "host-probe"]},
        "executable": {"$ref": "#/$defs/text"},
        "arguments": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/text"}},
        "working_directory_ref": {"type": "string", "pattern": "^repo://[^\\s]+$"},
        "environment_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:env|secret)://[^\\s]+$"}},
        "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "output_budget_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "invocation_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
