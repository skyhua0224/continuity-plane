{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-04/patch-ab-score-evidence.schema.json",
  "title": "Patch A/B Score Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "score_id", "experiment_id",
    "experiment_sha256", "verifier_packet_sha256", "verifier_id",
    "assignment_token", "rubric_scores", "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.patch-ab-score-evidence/v1alpha1"},
    "evidence_id": {"$ref": "#/$defs/id"},
    "score_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "experiment_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_packet_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_id": {"$ref": "#/$defs/id"},
    "assignment_token": {"$ref": "#/$defs/id"},
    "rubric_scores": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rubric_id", "score_basis_points"],
        "properties": {
          "rubric_id": {"$ref": "#/$defs/id"},
          "score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
        }
      }
    },
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
