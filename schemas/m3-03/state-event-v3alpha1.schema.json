{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.state-event/v3alpha1",
  "title": "Context Control Plane append-only state event v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "project_id",
    "sequence_no",
    "revision_before",
    "revision_after",
    "occurred_at",
    "actor_ref",
    "causation_ref",
    "correlation_ref",
    "previous_event_sha256",
    "supersedes_event_id",
    "changes",
    "project_after",
    "task_transition",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.state-event/v3alpha1"},
    "event_id": {"$ref": "#/$defs/nonEmptyString"},
    "event_type": {"enum": ["state-transition", "correction"]},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "sequence_no": {"type": "integer", "minimum": 1},
    "revision_before": {"type": "integer", "minimum": 0},
    "revision_after": {"type": "integer", "minimum": 1},
    "occurred_at": {"$ref": "#/$defs/timestamp"},
    "actor_ref": {"$ref": "#/$defs/nonEmptyString"},
    "causation_ref": {"$ref": "#/$defs/nullableString"},
    "correlation_ref": {"$ref": "#/$defs/nullableString"},
    "previous_event_sha256": {"$ref": "#/$defs/nullableSha256"},
    "supersedes_event_id": {"$ref": "#/$defs/nullableString"},
    "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "project_after": {"$ref": "https://context-control-plane.dev/schema/context.typed-state/v2alpha1#/$defs/project"},
    "task_transition": {"anyOf": [{"$ref": "#/$defs/taskTransition"}, {"type": "null"}]},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "state-transition"}}},
      "then": {"properties": {"supersedes_event_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "correction"}}},
      "then": {"properties": {"supersedes_event_id": {"$ref": "#/$defs/nonEmptyString"}}}
    },
    {
      "if": {"required": ["task_transition"], "properties": {"task_transition": {"type": "object", "required": ["route_kind"], "properties": {"route_kind": {"const": "child"}}}}},
      "then": {"properties": {"event_type": {"const": "state-transition"}, "supersedes_event_id": {"type": "null"}, "task_transition": {"$ref": "#/$defs/childTransition"}}}
    },
    {
      "if": {"required": ["task_transition"], "properties": {"task_transition": {"type": "object", "required": ["route_kind"], "properties": {"route_kind": {"enum": ["interrupt", "switch"]}}}}},
      "then": {"properties": {"event_type": {"const": "state-transition"}, "supersedes_event_id": {"type": "null"}, "task_transition": {"$ref": "#/$defs/switchTransition"}}}
    },
    {
      "if": {"required": ["task_transition"], "properties": {"task_transition": {"type": "object", "required": ["route_kind"], "properties": {"route_kind": {"const": "correction"}}}}},
      "then": {"properties": {"event_type": {"const": "correction"}, "supersedes_event_id": {"$ref": "#/$defs/nonEmptyString"}, "task_transition": {"$ref": "#/$defs/correctionTransition"}}}
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "nullableString": {"type": ["string", "null"], "minLength": 1, "pattern": ".*\\S.*"},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "digest_algorithm", "digest", "size_bytes", "artifact_uri"],
      "properties": {
        "schema_version": {"const": "context.artifact-ref/v1alpha1"},
        "digest_algorithm": {"const": "sha-256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "artifact_uri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"}
      }
    },
    "taskEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_event_id", "event_kind", "work_id", "work_revision", "return_work_id", "checkpoint_ref", "related_event_id"],
      "properties": {
        "task_event_id": {"$ref": "#/$defs/nonEmptyString"},
        "event_kind": {"enum": ["child_proposed", "task_suspended", "task_activated", "correction_applied"]},
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_revision": {"type": "integer", "minimum": 0},
        "return_work_id": {"$ref": "#/$defs/nullableString"},
        "checkpoint_ref": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "related_event_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "taskTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_decision_sha256", "route_apply_request_sha256", "route_kind", "task_events"],
      "properties": {
        "route_decision_sha256": {"$ref": "#/$defs/sha256"},
        "route_apply_request_sha256": {"$ref": "#/$defs/sha256"},
        "route_kind": {"enum": ["child", "interrupt", "switch", "correction"]},
        "task_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskEvent"}}
      }
    },
    "childTransition": {
      "allOf": [
        {"$ref": "#/$defs/taskTransition"},
        {"properties": {"task_events": {"prefixItems": [{"$ref": "#/$defs/childTaskEvent"}], "items": false, "minItems": 1, "maxItems": 1}}}
      ]
    },
    "switchTransition": {
      "allOf": [
        {"$ref": "#/$defs/taskTransition"},
        {"properties": {"task_events": {"prefixItems": [{"$ref": "#/$defs/suspendedTaskEvent"}, {"$ref": "#/$defs/activatedTaskEvent"}], "items": false, "minItems": 2, "maxItems": 2}}}
      ]
    },
    "correctionTransition": {
      "allOf": [
        {"$ref": "#/$defs/taskTransition"},
        {"properties": {"task_events": {"prefixItems": [{"$ref": "#/$defs/correctionTaskEvent"}], "items": false, "minItems": 1, "maxItems": 1}}}
      ]
    },
    "childTaskEvent": {"allOf": [{"$ref": "#/$defs/taskEvent"}, {"properties": {"event_kind": {"const": "child_proposed"}}}]},
    "suspendedTaskEvent": {"allOf": [{"$ref": "#/$defs/taskEvent"}, {"properties": {"event_kind": {"const": "task_suspended"}}}]},
    "activatedTaskEvent": {"allOf": [{"$ref": "#/$defs/taskEvent"}, {"properties": {"event_kind": {"const": "task_activated"}}}]},
    "correctionTaskEvent": {"allOf": [{"$ref": "#/$defs/taskEvent"}, {"properties": {"event_kind": {"const": "correction_applied"}}}]},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "object_id", "value"],
      "properties": {
        "collection": {"enum": ["works", "claims", "ideas", "decisions", "constraints", "evidence", "blockers", "effects"]},
        "object_id": {"$ref": "#/$defs/nonEmptyString"},
        "value": {"type": "object"}
      }
    }
  }
}
