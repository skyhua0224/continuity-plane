{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-control-plane/m1-02/source-registry.schema.json",
  "title": "M1-02 Source Registry",
  "x-schema-version": "m1-02.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "opaque_key_id", "records"],
  "properties": {
    "schema_version": {"const": "m1-02.v1"},
    "opaque_key_id": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "source_provider",
        "source_thread_ref",
        "source_kind",
        "retention_class"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "source_provider": {"enum": ["codex", "claude", "cursor", "other"]},
        "source_thread_ref": {"pattern": "^thr_[a-z2-7]{26}$"},
        "source_kind": {"enum": ["raw_transcript", "handoff", "memory", "other"]},
        "retention_class": {"enum": ["ephemeral", "project", "audit"]}
      }
    }
  }
}
