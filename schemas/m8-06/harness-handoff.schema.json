{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.harness-handoff/v1alpha1",
  "title": "Provider-neutral Harness handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "source_run_id", "target_run_id", "task_revision", "checkpoint_id", "next_action", "status", "actual_first_action", "created_at", "updated_at", "handoff_sha256"],
  "properties": {
    "schema_version": {"const": "context.harness-handoff/v1alpha1"},
    "handoff_id": {"$ref": "#/$defs/id"},
    "source_run_id": {"$ref": "#/$defs/id"},
    "target_run_id": {"$ref": "#/$defs/id"},
    "task_revision": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"$ref": "#/$defs/id"},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 512},
    "status": {"enum": ["pending", "accepted"]},
    "actual_first_action": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "handoff_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
