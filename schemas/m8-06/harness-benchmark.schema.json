{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.harness-benchmark/v1alpha1",
  "title": "M8-06 Harness Run benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "generated_at", "samples", "provider_drift_attempts", "worker_loss_attempts", "effect_attempts", "stale_handoff_attempts", "first_action_attempts", "replay_attempts", "metrics", "rates", "latency_ms", "thresholds", "provider_invocations", "external_services", "shared_authority_claim", "provenance", "verdict", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.harness-benchmark/v1alpha1"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark-m8-06-[0-9a-f]{24}$"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "samples": {"type": "integer", "minimum": 1},
    "provider_drift_attempts": {"type": "integer", "minimum": 1},
    "worker_loss_attempts": {"type": "integer", "minimum": 1},
    "effect_attempts": {"type": "integer", "minimum": 1},
    "stale_handoff_attempts": {"type": "integer", "minimum": 1},
    "first_action_attempts": {"type": "integer", "minimum": 1},
    "replay_attempts": {"type": "integer", "minimum": 1},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["provider_drift_rejections", "worker_loss_authority_unchanged", "effect_scope_rejections", "stale_handoff_rejections", "first_action_mismatch_rejections", "replay_matches", "fanout_dispatches", "fanin_completions"], "properties": {"provider_drift_rejections": {"type": "integer", "minimum": 0}, "worker_loss_authority_unchanged": {"type": "integer", "minimum": 0}, "effect_scope_rejections": {"type": "integer", "minimum": 0}, "stale_handoff_rejections": {"type": "integer", "minimum": 0}, "first_action_mismatch_rejections": {"type": "integer", "minimum": 0}, "replay_matches": {"type": "integer", "minimum": 0}, "fanout_dispatches": {"type": "integer", "minimum": 0}, "fanin_completions": {"type": "integer", "minimum": 0}}},
    "rates": {"type": "object", "additionalProperties": false, "required": ["provider_drift_rejection_rate", "worker_loss_unchanged_rate", "effect_scope_rejection_rate", "stale_handoff_rejection_rate", "first_action_rejection_rate", "replay_match_rate"], "properties": {"provider_drift_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1}, "worker_loss_unchanged_rate": {"type": "number", "minimum": 0, "maximum": 1}, "effect_scope_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1}, "stale_handoff_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1}, "first_action_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1}, "replay_match_rate": {"type": "number", "minimum": 0, "maximum": 1}}},
    "latency_ms": {"type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms", "max_ms"], "properties": {"p50_ms": {"type": "number", "exclusiveMinimum": 0}, "p95_ms": {"type": "number", "exclusiveMinimum": 0}, "max_ms": {"type": "number", "exclusiveMinimum": 0}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["provider_drift_rejection_rate_min", "worker_loss_unchanged_rate_min", "effect_scope_rejection_rate_min", "stale_handoff_rejection_rate_min", "first_action_rejection_rate_min", "replay_match_rate_min", "latency_p95_ms_max"], "properties": {"provider_drift_rejection_rate_min": {"const": 1.0}, "worker_loss_unchanged_rate_min": {"const": 1.0}, "effect_scope_rejection_rate_min": {"const": 1.0}, "stale_handoff_rejection_rate_min": {"const": 1.0}, "first_action_rejection_rate_min": {"const": 1.0}, "replay_match_rate_min": {"const": 1.0}, "latency_p95_ms_max": {"const": 50.0}}},
    "provider_invocations": {"const": 0},
    "external_services": {"const": 0},
    "shared_authority_claim": {"const": false},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["implementation_sha256", "benchmark_sha256", "run_schema_sha256", "event_schema_sha256", "handoff_schema_sha256"], "properties": {"implementation_sha256": {"$ref": "#/$defs/sha256"}, "benchmark_sha256": {"$ref": "#/$defs/sha256"}, "run_schema_sha256": {"$ref": "#/$defs/sha256"}, "event_schema_sha256": {"$ref": "#/$defs/sha256"}, "handoff_schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["decision", "failed_gates"], "properties": {"decision": {"enum": ["pass", "fail"]}, "failed_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
