{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.harness-event/v1alpha1",
  "title": "Provider-neutral Harness Run event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence_no", "event_type", "project_id", "task_revision", "observed_at", "payload", "previous_event_sha256", "event_sha256"],
  "properties": {
    "schema_version": {"const": "context.harness-event/v1alpha1"},
    "event_id": {"$ref": "#/$defs/id"},
    "sequence_no": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["run-registered", "worker-dispatch", "worker-loss", "worker-completed", "fan-in", "effect-dispatch", "handoff-created", "handoff-accepted"]},
    "project_id": {"$ref": "#/$defs/id"},
    "task_revision": {"type": "integer", "minimum": 1},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "payload": {"type": "object"},
    "previous_event_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
