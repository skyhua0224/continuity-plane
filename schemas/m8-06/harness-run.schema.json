{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.harness-run/v1alpha1",
  "title": "Provider-neutral Context Control Plane Harness Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project_id", "task_id", "task_revision", "claim_id", "claim_lease_epoch", "claim_fence", "provider", "provider_contract_version", "execution_packet_sha256", "skill_set_digest", "tool_grants", "checkpoint_id", "effect_high_watermark", "verification_profile_id", "reference_validity_watermark", "trace_id", "status", "parent_run_id", "scope_refs", "created_at", "updated_at", "state_write_authority", "effect_dispatch_authority", "provider_native_authority", "run_sha256"],
  "properties": {
    "schema_version": {"const": "context.harness-run/v1alpha1"},
    "run_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_revision": {"type": "integer", "minimum": 1},
    "claim_id": {"$ref": "#/$defs/id"},
    "claim_lease_epoch": {"type": "integer", "minimum": 1},
    "claim_fence": {"type": "integer", "minimum": 1},
    "provider": {"enum": ["codex", "claude", "deepseek", "pi", "other"]},
    "provider_contract_version": {"$ref": "#/$defs/id"},
    "execution_packet_sha256": {"$ref": "#/$defs/sha256"},
    "skill_set_digest": {"$ref": "#/$defs/sha256"},
    "tool_grants": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "checkpoint_id": {"$ref": "#/$defs/id"},
    "effect_high_watermark": {"type": "integer", "minimum": 0},
    "verification_profile_id": {"$ref": "#/$defs/id"},
    "reference_validity_watermark": {"type": "integer", "minimum": 0},
    "trace_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["proposed", "running", "waiting", "verifying", "completed", "failed", "quarantined"]},
    "parent_run_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "scope_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "state_write_authority": {"const": false},
    "effect_dispatch_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "run_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {"enum": ["repo", "directory", "file", "symbol", "capability", "effect"]},
        "scope_ref": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
