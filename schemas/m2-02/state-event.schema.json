{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.dev/schema/context.state-event/v1alpha1",
  "title": "Continuity Plane append-only state event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "project_id",
    "sequence_no",
    "revision_before",
    "revision_after",
    "occurred_at",
    "actor_ref",
    "causation_ref",
    "correlation_ref",
    "previous_event_sha256",
    "supersedes_event_id",
    "changes",
    "project_after",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.state-event/v1alpha1"},
    "event_id": {"$ref": "#/$defs/nonEmptyString"},
    "event_type": {"enum": ["state-transition", "correction"]},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "sequence_no": {"type": "integer", "minimum": 1},
    "revision_before": {"type": "integer", "minimum": 0},
    "revision_after": {"type": "integer", "minimum": 1},
    "occurred_at": {"$ref": "#/$defs/timestamp"},
    "actor_ref": {"$ref": "#/$defs/nonEmptyString"},
    "causation_ref": {"$ref": "#/$defs/nullableString"},
    "correlation_ref": {"$ref": "#/$defs/nullableString"},
    "previous_event_sha256": {"$ref": "#/$defs/nullableSha256"},
    "supersedes_event_id": {"$ref": "#/$defs/nullableString"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/change"}
    },
    "project_after": {
      "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/project"
    },
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "state-transition"}}},
      "then": {"properties": {"supersedes_event_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "correction"}}},
      "then": {
        "properties": {
          "supersedes_event_id": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "object_id", "value"],
      "properties": {
        "collection": {
          "enum": [
            "works",
            "claims",
            "ideas",
            "decisions",
            "constraints",
            "evidence",
            "blockers",
            "effects"
          ]
        },
        "object_id": {"$ref": "#/$defs/nonEmptyString"},
        "value": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"collection": {"const": "works"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/work"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "claims"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/claim"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "ideas"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/idea"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "decisions"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/decision"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "constraints"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/constraint"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "evidence"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/evidence"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "blockers"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/blocker"
              }
            }
          }
        },
        {
          "if": {"properties": {"collection": {"const": "effects"}}},
          "then": {
            "properties": {
              "value": {
                "$ref": "https://continuity.dev/schema/context.typed-state/v1alpha1#/$defs/effect"
              }
            }
          }
        }
      ]
    }
  }
}
