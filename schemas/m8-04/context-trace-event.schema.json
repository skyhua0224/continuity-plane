{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-04/context-trace-event.schema.json",
  "title": "Context Control Plane Trace Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_name",
    "sequence",
    "previous_event_sha256",
    "project_id",
    "state_revision",
    "active_work_id",
    "trace_id",
    "span_id",
    "run_id",
    "operation_id",
    "correlation_id",
    "source",
    "evidence_refs",
    "observed_at",
    "attributes",
    "authority",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.trace-event/v1alpha1"},
    "event_id": {"$ref": "#/$defs/id"},
    "event_name": {
      "type": "string",
      "pattern": "^context\\.[a-z][a-z0-9_.-]{0,126}$"
    },
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/id"},
    "state_revision": {"type": "integer", "minimum": 0},
    "active_work_id": {"$ref": "#/$defs/id"},
    "trace_id": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
    },
    "run_id": {"$ref": "#/$defs/id"},
    "operation_id": {"$ref": "#/$defs/id"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "source": {"$ref": "#/$defs/source"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "attributes": {"type": "object"},
    "authority": {"const": false},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "adapter", "source_ref"],
      "properties": {
        "kind": {"$ref": "#/$defs/id"},
        "provider": {"$ref": "#/$defs/id"},
        "adapter": {"$ref": "#/$defs/id"},
        "source_ref": {"$ref": "#/$defs/reference"}
      }
    }
  }
}
