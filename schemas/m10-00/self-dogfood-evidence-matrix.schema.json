{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m10-00/self-dogfood-evidence-matrix.schema.json",
  "title": "M10-00 self-dogfood E0-E9 evidence admission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_sha256", "campaign_id", "project_id", "state_revision", "observed_at", "entries", "admitted_count", "pending_count", "completion_status", "authority", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.self-dogfood-evidence-matrix/v1alpha1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "state_revision": {"type": "integer", "minimum": 0},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "entries": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/entry"}},
    "admitted_count": {"const": 10},
    "pending_count": {"const": 10},
    "completion_status": {"const": "ready-for-runtime"},
    "authority": {"$ref": "#/$defs/authority"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256"],
      "properties": {"path": {"$ref": "#/$defs/id"}, "content_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "evidence_class", "veto", "applicability", "admission_status", "runtime_status", "evidence_refs", "limitation"],
      "properties": {
        "experiment_id": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9"]},
        "evidence_class": {"enum": ["historical-live-manual", "offline-admitted-replay", "local-runtime-contract", "local-runtime-fault", "synthetic-contract"]},
        "veto": {"type": "boolean"},
        "applicability": {"enum": ["applicable", "conditional"]},
        "admission_status": {"const": "candidate"},
        "runtime_status": {"const": "pending"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidenceRef"}},
        "limitation": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_write_authority", "completion_authority", "provider_authority", "external_effect_authority"],
      "properties": {
        "state_write_authority": {"const": false},
        "completion_authority": {"const": false},
        "provider_authority": {"const": 0},
        "external_effect_authority": {"const": 0}
      }
    }
  }
}
