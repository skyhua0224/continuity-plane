{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.continuity-plane.dev/context.state-claim-recovery-request/v1alpha1",
  "title": "Continuity Plane Legacy Local Claim Recovery Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "action",
    "expected_revision",
    "claim_id",
    "new_claim_id",
    "actor_ref",
    "scope_owners",
    "lease_ttl_ms",
    "causation_ref",
    "correlation_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "context.state-claim-recovery-request/v1alpha1"
    },
    "request_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "action": {"enum": ["heartbeat", "reclaim"]},
    "expected_revision": {"type": "integer", "minimum": 0},
    "claim_id": {"$ref": "#/$defs/id"},
    "new_claim_id": {
      "oneOf": [
        {"$ref": "#/$defs/id"},
        {"type": "null"}
      ]
    },
    "actor_ref": {"$ref": "#/$defs/id"},
    "scope_owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/scope"}
    },
    "lease_ttl_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800000
    },
    "causation_ref": {"$ref": "#/$defs/nullable_ref"},
    "correlation_ref": {"$ref": "#/$defs/nullable_ref"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "heartbeat"}}},
      "then": {"properties": {"new_claim_id": {"const": null}}},
      "else": {"properties": {"new_claim_id": {"$ref": "#/$defs/id"}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "nullable_ref": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 500},
        {"type": "null"}
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "scope_ref": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
