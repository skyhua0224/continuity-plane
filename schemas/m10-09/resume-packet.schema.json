{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.continuity-plane.dev/context.resume-packet/v1alpha1",
  "title": "Continuity Plane Resume Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "event_head",
    "active_work",
    "claim",
    "proposal_sha256",
    "source_fresh",
    "lease_valid",
    "read_only",
    "next_action",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "context.resume-packet/v1alpha1"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "event_head": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence_no",
            "event_sha256"
          ],
          "properties": {
            "sequence_no": {
              "type": "integer",
              "minimum": 1
            },
            "event_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "active_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "status",
        "revision",
        "scope_refs",
        "evidence_ids"
      ],
      "properties": {
        "work_id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "const": "active"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scope_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/scope_ref"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "actor_ref",
        "status",
        "lease_expires_at",
        "scope_owners"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/identifier"
        },
        "actor_ref": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "active"
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope_owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/scope_ref"
          }
        }
      }
    },
    "proposal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_fresh": {
      "type": "boolean"
    },
    "lease_valid": {
      "type": "boolean"
    },
    "read_only": {
      "type": "boolean"
    },
    "next_action": {
      "const": "continue-active-work"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_fresh": {
            "const": true
          },
          "lease_valid": {
            "const": true
          }
        },
        "required": [
          "source_fresh",
          "lease_valid"
        ]
      },
      "then": {
        "properties": {
          "read_only": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "read_only": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "scope_ref"
      ],
      "properties": {
        "scope_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
