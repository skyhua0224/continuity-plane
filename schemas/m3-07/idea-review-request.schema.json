{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.idea-review-request/v1alpha1",
  "title": "Context Control Plane Idea review request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "project_id", "expected_revision",
    "idea_id", "review_id", "decision", "urgency", "impact", "review_at",
    "evidence_ids", "causation_ref", "correlation_ref"
  ],
  "properties": {
    "schema_version": {"const": "context.idea-review-request/v1alpha1"},
    "request_id": {"$ref": "#/$defs/boundedId"},
    "project_id": {"$ref": "#/$defs/boundedId"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "idea_id": {"$ref": "#/$defs/boundedId"},
    "review_id": {"$ref": "#/$defs/boundedId"},
    "decision": {"enum": ["keep", "park", "reject", "supersede", "approve"]},
    "urgency": {"enum": ["immediate", "next", "later", "review-date"]},
    "impact": {"enum": ["none", "low", "medium", "high"]},
    "review_at": {"$ref": "#/$defs/nullableTimestamp"},
    "evidence_ids": {"$ref": "#/$defs/stringList"},
    "causation_ref": {"$ref": "#/$defs/nullableRef"},
    "correlation_ref": {"$ref": "#/$defs/nullableRef"}
  },
  "allOf": [
    {
      "if": {"properties": {"urgency": {"const": "review-date"}}},
      "then": {"properties": {"review_at": {"$ref": "#/$defs/timestamp"}}}
    }
  ],
  "$defs": {
    "boundedId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": ".*\\S.*"},
    "timestamp": {"type": "string", "format": "date-time"},
    "nullableTimestamp": {"type": ["string", "null"], "format": "date-time"},
    "nullableRef": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
