{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.continuation-dispatch-request/v1alpha1",
  "title": "Context Control Plane continuation dispatch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "expected_project_revision", "governance_profile_id", "expected_governance_revision", "intent_kind", "route_decision_sha256", "blocking_decision_sha256", "observed_at"],
  "properties": {
    "schema_version": {"const": "context.continuation-dispatch-request/v1alpha1"},
    "request_id": {"$ref": "#/$defs/nonEmptyString"},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "expected_project_revision": {"type": "integer", "minimum": 0},
    "governance_profile_id": {"$ref": "#/$defs/nonEmptyString"},
    "expected_governance_revision": {"type": "integer", "minimum": 0},
    "intent_kind": {"enum": ["routed_input", "blocking_decision", "dispatch_tick"]},
    "route_decision_sha256": {"$ref": "#/$defs/nullableSha256"},
    "blocking_decision_sha256": {"$ref": "#/$defs/nullableSha256"},
    "observed_at": {"type": "string", "format": "date-time", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"intent_kind": {"const": "routed_input"}}},
      "then": {"properties": {"route_decision_sha256": {"$ref": "#/$defs/sha256"}, "blocking_decision_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"intent_kind": {"const": "blocking_decision"}}},
      "then": {"properties": {"route_decision_sha256": {"type": "null"}, "blocking_decision_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {"properties": {"intent_kind": {"const": "dispatch_tick"}}},
      "then": {"properties": {"route_decision_sha256": {"type": "null"}, "blocking_decision_sha256": {"type": "null"}}}
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
