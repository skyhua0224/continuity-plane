{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.continuation-dispatch-decision/v1alpha1",
  "title": "Context Control Plane continuation dispatch decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_sha256", "project_id", "project_revision", "governance_revision", "observed_at", "intent_kind", "input_ref", "input_sha256", "input_kind", "classifier_provenance_ref", "action", "reason_code", "active_work_id_before", "active_work_id_after", "active_work_revision_before", "active_work_revision_after", "selected_work_id", "selected_work_revision", "blocker_id", "blocker_kind", "reason", "affected_work_ids", "evidence_ids", "governance_evidence_refs", "decision_options", "default_behavior", "affected_scope_refs", "resume_condition", "pending_route_decision_sha256", "state_write_authority"],
  "properties": {
    "schema_version": {"const": "context.continuation-dispatch-decision/v1alpha1"},
    "request_id": {"$ref": "#/$defs/nonEmptyString"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "project_revision": {"type": "integer", "minimum": 0},
    "governance_revision": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time", "minLength": 1},
    "intent_kind": {"enum": ["routed_input", "blocking_decision", "dispatch_tick"]},
    "input_ref": {"$ref": "#/$defs/nullableString"},
    "input_sha256": {"$ref": "#/$defs/nullableSha256"},
    "input_kind": {"$ref": "#/$defs/nullableString"},
    "classifier_provenance_ref": {"$ref": "#/$defs/nullableString"},
    "action": {"enum": ["continue-active", "capture-and-continue", "select-next-ready", "ask-user", "stop-blocked", "stop-complete"]},
    "reason_code": {"$ref": "#/$defs/nonEmptyString"},
    "active_work_id_before": {"$ref": "#/$defs/nullableString"},
    "active_work_id_after": {"$ref": "#/$defs/nullableString"},
    "active_work_revision_before": {"type": ["integer", "null"], "minimum": 0},
    "active_work_revision_after": {"type": ["integer", "null"], "minimum": 0},
    "selected_work_id": {"$ref": "#/$defs/nullableString"},
    "selected_work_revision": {"type": ["integer", "null"], "minimum": 0},
    "blocker_id": {"$ref": "#/$defs/nullableString"},
    "blocker_kind": {"$ref": "#/$defs/nullableBlockerKind"},
    "reason": {"$ref": "#/$defs/nullableString"},
    "affected_work_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "governance_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "decision_options": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/option"}},
    "default_behavior": {"$ref": "#/$defs/nullableString"},
    "affected_scope_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}},
    "resume_condition": {"$ref": "#/$defs/nullableResumeCondition"},
    "pending_route_decision_sha256": {"$ref": "#/$defs/nullableSha256"},
    "state_write_authority": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"intent_kind": {"const": "routed_input"}}}, "then": {"required": ["input_ref", "input_sha256", "input_kind", "classifier_provenance_ref"]}},
    {"if": {"properties": {"intent_kind": {"not": {"const": "routed_input"}}}}, "then": {"properties": {"input_ref": {"type": "null"}, "input_sha256": {"type": "null"}, "input_kind": {"type": "null"}, "classifier_provenance_ref": {"type": "null"}}}},
    {"if": {"properties": {"action": {"const": "ask-user"}}}, "then": {"required": ["blocker_id", "blocker_kind", "reason", "resume_condition"], "properties": {"blocker_kind": {"enum": ["irreversible-effect-authorization-required", "approved-constraint-conflict", "acceptance-output-choice-required"]}, "decision_options": {"minItems": 2}, "affected_work_ids": {"minItems": 1}, "evidence_ids": {"minItems": 1}, "affected_scope_refs": {"minItems": 1}}}},
    {"if": {"properties": {"action": {"const": "stop-blocked"}}}, "then": {"required": ["blocker_id", "blocker_kind", "reason", "resume_condition"], "properties": {"blocker_kind": {"const": "external-completion-evidence-unavailable"}, "decision_options": {"maxItems": 0}, "default_behavior": {"type": "null"}, "affected_work_ids": {"minItems": 1}, "evidence_ids": {"minItems": 1}, "affected_scope_refs": {"minItems": 1}}}},
    {"if": {"properties": {"action": {"const": "stop-complete"}}}, "then": {"required": ["reason", "resume_condition"], "properties": {"active_work_id_before": {"type": "null"}, "active_work_id_after": {"type": "null"}, "selected_work_id": {"type": "null"}, "blocker_id": {"type": "null"}, "blocker_kind": {"type": "null"}, "affected_work_ids": {"maxItems": 0}, "governance_evidence_refs": {"minItems": 1}, "decision_options": {"maxItems": 0}, "affected_scope_refs": {"maxItems": 0}}}}
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "nullableString": {"type": ["string", "null"], "minLength": 1, "pattern": ".*\\S.*"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "nullableBlockerKind": {"type": ["string", "null"], "enum": ["irreversible-effect-authorization-required", "approved-constraint-conflict", "acceptance-output-choice-required", "external-completion-evidence-unavailable", null]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_kind", "scope_ref"], "properties": {"scope_kind": {"enum": ["repo", "directory", "file", "symbol", "capability", "effect"]}, "scope_ref": {"$ref": "#/$defs/nonEmptyString"}}},
    "option": {"type": "object", "additionalProperties": false, "required": ["option_id", "summary"], "properties": {"option_id": {"$ref": "#/$defs/nonEmptyString"}, "summary": {"$ref": "#/$defs/nonEmptyString"}}},
    "nullableResumeCondition": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind", "refs"], "properties": {"kind": {"enum": ["authorization", "decision", "evidence", "blocker_resolved", "new_ready_work"]}, "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}}}
  }
}
