{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.task-route-request/v1alpha1",
  "title": "Context Control Plane sticky route request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "expected_project_revision", "active_work_id", "expected_active_work_revision", "input_ref", "input_sha256", "input_kind", "classifier_confidence_millionths", "classifier_provenance_ref", "target_work_id", "user_authorization_candidate", "authorization_candidate_ref", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "context.task-route-request/v1alpha1"},
    "request_id": {"$ref": "#/$defs/nonEmptyString"},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "expected_project_revision": {"type": "integer", "minimum": 0},
    "active_work_id": {"$ref": "#/$defs/nonEmptyString"},
    "expected_active_work_revision": {"type": "integer", "minimum": 0},
    "input_ref": {"$ref": "#/$defs/nonEmptyString"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "input_kind": {"enum": ["continue", "status_query", "discussion_request", "context_addition", "idea", "correction", "child_work", "interrupt", "switch"]},
    "classifier_confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "classifier_provenance_ref": {"$ref": "#/$defs/nonEmptyString"},
    "target_work_id": {"$ref": "#/$defs/nullableString"},
    "user_authorization_candidate": {"type": "boolean"},
    "authorization_candidate_ref": {"$ref": "#/$defs/nullableString"},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"input_kind": {"const": "child_work"}}},
      "then": {"properties": {"target_work_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"input_kind": {"not": {"enum": ["interrupt", "switch"]}}}},
      "then": {
        "properties": {
          "user_authorization_candidate": {"const": false},
          "authorization_candidate_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"user_authorization_candidate": {"const": false}}},
      "then": {"properties": {"authorization_candidate_ref": {"type": "null"}}}
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "nullableString": {"type": ["string", "null"], "minLength": 1, "pattern": ".*\\S.*"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
