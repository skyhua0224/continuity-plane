{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.local/schemas/m2-05/state-mcp.schema.json",
  "title": "Continuity Plane State MCP Contract",
  "oneOf": [
    {"$ref": "#/$defs/read_request"},
    {"$ref": "#/$defs/commit_request"},
    {"$ref": "#/$defs/claim_request"},
    {"$ref": "#/$defs/effect_request"},
    {"$ref": "#/$defs/effect_gate_request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {
          "enum": ["repo", "directory", "file", "symbol", "capability", "effect"]
        },
        "scope_ref": {"type": "string", "minLength": 1}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "object_id", "value"],
      "properties": {
        "collection": {
          "enum": ["works", "ideas", "decisions", "constraints", "evidence", "blockers"]
        },
        "object_id": {"type": "string", "minLength": 1},
        "value": {"type": "object"}
      }
    },
    "read_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "commit_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "causation_ref", "correlation_ref", "supersedes_event_id", "changes"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "causation_ref": {"type": ["string", "null"]},
        "correlation_ref": {"type": ["string", "null"]},
        "supersedes_event_id": {"type": ["string", "null"]},
        "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}}
      }
    },
    "claim_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "work_id", "claim_id", "scope_owners", "lease_expires_at", "causation_ref", "correlation_ref"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "work_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "scope_owners": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope_ref"}},
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "causation_ref": {"type": ["string", "null"]},
        "correlation_ref": {"type": ["string", "null"]}
      }
    },
    "effect_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "action", "effect_id", "effect_key", "work_id", "claim_id", "operation", "scope_ref", "result_ref", "evidence_ids", "causation_ref", "correlation_ref"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "action": {"enum": ["authorize", "complete"]},
        "effect_id": {"type": "string", "minLength": 1},
        "effect_key": {"type": "string", "minLength": 1},
        "work_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "scope_ref": {"$ref": "#/$defs/scope_ref"},
        "result_ref": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "causation_ref": {"type": ["string", "null"]},
        "correlation_ref": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"action": {"const": "authorize"}},
            "required": ["action"]
          },
          "then": {"properties": {"result_ref": {"type": "null"}}},
          "else": {
            "properties": {
              "result_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "effect_gate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "effect_id", "work_id", "claim_id", "operation", "scope_ref"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "effect_id": {"type": "string", "minLength": 1},
        "work_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "scope_ref": {"$ref": "#/$defs/scope_ref"}
      }
    },
    "event_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_no", "event_sha256"],
      "properties": {
        "sequence_no": {"type": "integer", "minimum": 1},
        "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "read_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "revision", "event_head", "registry_digest", "capabilities"],
      "properties": {
        "snapshot": {"type": "object"},
        "revision": {"type": "integer", "minimum": 0},
        "event_head": {
          "oneOf": [{"$ref": "#/$defs/event_head"}, {"type": "null"}]
        },
        "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capabilities": {"type": "object"}
      }
    },
    "mutation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "revision", "event_head", "event", "registry_digest", "capabilities"],
      "properties": {
        "snapshot": {"type": "object"},
        "revision": {"type": "integer", "minimum": 0},
        "event_head": {"$ref": "#/$defs/event_head"},
        "event": {"type": "object"},
        "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capabilities": {"type": "object"}
      }
    },
    "effect_scope_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "decision", "read_only", "reason"],
      "properties": {
        "schema_version": {"const": "context.effect-scope-verdict/v1alpha1"},
        "decision": {"enum": ["allow", "deny"]},
        "read_only": {"type": "boolean"},
        "reason": {
          "enum": [
            "authorized",
            "stale_revision",
            "inactive_work",
            "work_not_ready",
            "actor_not_owner",
            "claim_mismatch",
            "claim_revision_mismatch",
            "actor_mismatch",
            "claim_expired",
            "scope_outside_work",
            "scope_not_owned",
            "scope_conflict",
            "effect_scope_conflict",
            "operation_invalid",
            "scope_invalid",
            "operation_scope_mismatch",
            "effect_not_found",
            "effect_not_pending",
            "effect_provenance_mismatch",
            "completion_actor_mismatch"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"decision": {"const": "allow"}},
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "read_only": {"const": false},
              "reason": {"const": "authorized"}
            }
          },
          "else": {
            "properties": {
              "read_only": {"const": true},
              "reason": {"not": {"const": "authorized"}}
            }
          }
        }
      ]
    },
    "effect_gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "revision", "registry_digest", "capabilities"],
      "properties": {
        "verdict": {"$ref": "#/$defs/effect_scope_verdict"},
        "revision": {"type": "integer", "minimum": 0},
        "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capabilities": {"type": "object"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["permission_denied", "not_found", "conflict", "invalid_request", "integrity", "capability", "busy", "unsupported"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "tool", "ok", "result", "error"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-response/v1alpha1"},
        "request_id": {"type": ["string", "null"]},
        "tool": {"type": "string", "minLength": 1},
        "ok": {"type": "boolean"},
        "result": {"type": ["object", "null"]},
        "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"ok": {"const": true}},
            "required": ["ok"]
          },
          "then": {
            "properties": {
              "error": {"type": "null"}
            },
            "oneOf": [
              {
                "properties": {
                  "tool": {"const": "context.state.read"},
                  "result": {"$ref": "#/$defs/read_result"}
                }
              },
              {
                "properties": {
                  "tool": {
                    "enum": ["context.state.commit", "context.state.claim", "context.state.effect"]
                  },
                  "result": {"$ref": "#/$defs/mutation_result"}
                }
              },
              {
                "properties": {
                  "tool": {"const": "context.state.effect.gate"},
                  "result": {"$ref": "#/$defs/effect_gate_result"}
                }
              }
            ]
          },
          "else": {
            "properties": {
              "result": {"type": "null"},
              "error": {"$ref": "#/$defs/error"}
            }
          }
        }
      ]
    }
  }
}
