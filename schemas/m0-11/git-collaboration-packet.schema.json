{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m0-11/git-collaboration-packet.schema.json",
  "title": "Context Control Plane Git Collaboration Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "branch", "commit", "pull_request"],
  "properties": {
    "schema_version": {"const": "context.git-collaboration-packet/v1alpha1"},
    "branch": {"$ref": "#/$defs/branch"},
    "commit": {"$ref": "#/$defs/commit"},
    "pull_request": {"$ref": "#/$defs/pull_request"}
  },
  "$defs": {
    "non_empty": {"type": "string", "minLength": 1},
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "parent_id", "scope", "return_point", "exit_criteria", "attempt_budget", "expiry", "promotion_target", "mainline_authority"],
      "properties": {
        "branch_id": {"type": "string", "pattern": "^(?:work|experiment|fix|docs)/[A-Z][0-9]+-[0-9]+/[a-z0-9]+(?:-[a-z0-9]+)*(?:--[a-z0-9]{2,32})?$"},
        "parent_id": {"$ref": "#/$defs/non_empty"},
        "scope": {"$ref": "#/$defs/non_empty"},
        "return_point": {"$ref": "#/$defs/non_empty"},
        "exit_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty"}},
        "attempt_budget": {"type": "integer", "minimum": 1},
        "expiry": {"type": ["string", "null"]},
        "promotion_target": {"type": ["string", "null"]},
        "mainline_authority": {"const": false}
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body"],
      "properties": {
        "subject": {"type": "string", "pattern": "^(?:feat|fix|docs|test|refactor|perf|chore|build|ci)(?:\\([a-z][a-z0-9-]*\\))?: [^\\n.]{1,72}$"},
        "body": {"type": "string", "minLength": 1}
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {"type": "string", "pattern": "^(?:feat|fix|docs|test|refactor|perf|chore|build|ci)(?:\\([a-z][a-z0-9-]*\\))?: [^\\n.]{1,72}$"},
        "body": {"type": "string", "minLength": 1}
      }
    }
  }
}
