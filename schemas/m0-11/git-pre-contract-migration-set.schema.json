{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m0-11/git-pre-contract-migration-set.schema.json",
  "title": "Context Control Plane Git Pre-Contract Migration Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "migrations"],
  "properties": {
    "schema_version": {"const": "context.git-pre-contract-migration-set/v1alpha1"},
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/migration"}
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "root_commit",
        "root_tree",
        "message_sha256",
        "contract_introduction_commit",
        "allowed_deviations",
        "current_tree_admission_required",
        "runtime_state_authority"
      ],
      "properties": {
        "migration_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$"},
        "root_commit": {"$ref": "#/$defs/commit"},
        "root_tree": {"$ref": "#/$defs/commit"},
        "message_sha256": {"$ref": "#/$defs/sha256"},
        "contract_introduction_commit": {"$ref": "#/$defs/commit"},
        "allowed_deviations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["missing-why-label", "legacy-evidence-syntax"]
          }
        },
        "current_tree_admission_required": {"const": true},
        "runtime_state_authority": {"const": false}
      }
    }
  }
}
