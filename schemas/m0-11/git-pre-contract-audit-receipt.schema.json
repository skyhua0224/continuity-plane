{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m0-11/git-pre-contract-audit-receipt.schema.json",
  "title": "Context Control Plane Git Pre-Contract Audit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_kind",
    "root_commit",
    "root_tree",
    "message_sha256",
    "commit_count_before_root",
    "author_name",
    "author_email",
    "contract_mode",
    "migration_ref",
    "contract_introduction_commit",
    "allowed_deviations",
    "root_tree_admission",
    "runtime_state_authority"
  ],
  "properties": {
    "schema_version": {"const": "context.git-pre-contract-audit-receipt/v1alpha1"},
    "admission_kind": {"const": "first-commit-pre-contract"},
    "root_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "root_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit_count_before_root": {"const": 0},
    "author_name": {"type": "string", "minLength": 1},
    "author_email": {"type": "string", "minLength": 3},
    "contract_mode": {"const": "pre-contract-migration"},
    "migration_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$"},
    "contract_introduction_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "allowed_deviations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["missing-why-label", "legacy-evidence-syntax"]}
    },
    "root_tree_admission": {"const": "passed"},
    "runtime_state_authority": {"const": false}
  }
}
