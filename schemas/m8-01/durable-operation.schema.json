{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-01/durable-operation.schema.json",
  "title": "Context Control Plane Durable Operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "project_id", "work_id", "claim_id",
    "authority", "effect", "checkpoint_ref", "continuation_sha256",
    "trace_binding", "phase", "record_revision", "previous_record_sha256",
    "attempt_count", "intent_ref", "start_ref", "settlement_ref", "result_ref",
    "state_commit_ref", "reconciliation_reason", "created_at", "updated_at",
    "state_write_authority", "provider_native_authority", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.durable-operation/v1alpha1"},
    "operation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "claim_id": {"$ref": "#/$defs/id"},
    "authority": {"$ref": "#/$defs/authority"},
    "effect": {"$ref": "#/$defs/effect"},
    "checkpoint_ref": {"$ref": "#/$defs/artifactRef"},
    "continuation_sha256": {"$ref": "#/$defs/sha256"},
    "trace_binding": {"$ref": "#/$defs/traceBinding"},
    "phase": {"enum": ["prepared", "intent-committed", "effect-in-flight", "outcome-unknown", "effect-settled", "response-committed", "terminal", "quarantined"]},
    "record_revision": {"$ref": "#/$defs/nonNegativeInteger"},
    "previous_record_sha256": {"$ref": "#/$defs/nullableSha256"},
    "attempt_count": {"$ref": "#/$defs/nonNegativeInteger"},
    "intent_ref": {"$ref": "#/$defs/nullableReference"},
    "start_ref": {"$ref": "#/$defs/nullableReference"},
    "settlement_ref": {"$ref": "#/$defs/nullableReference"},
    "result_ref": {"$ref": "#/$defs/nullableReference"},
    "state_commit_ref": {"$ref": "#/$defs/nullableReference"},
    "reconciliation_reason": {"$ref": "#/$defs/nullableReference"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "state_write_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "prepared"}}},
      "then": {
        "properties": {
          "record_revision": {"const": 0},
          "previous_record_sha256": {"type": "null"},
          "attempt_count": {"const": 0},
          "intent_ref": {"type": "null"},
          "start_ref": {"type": "null"},
          "settlement_ref": {"type": "null"},
          "result_ref": {"type": "null"},
          "state_commit_ref": {"type": "null"},
          "reconciliation_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"not": {"const": "prepared"}}}},
      "then": {
        "properties": {
          "record_revision": {"type": "integer", "minimum": 1},
          "previous_record_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"const": "intent-committed"}}},
      "then": {
        "properties": {
          "attempt_count": {"const": 0},
          "intent_ref": {"$ref": "#/$defs/reference"},
          "start_ref": {"type": "null"},
          "settlement_ref": {"type": "null"},
          "result_ref": {"type": "null"},
          "state_commit_ref": {"type": "null"},
          "reconciliation_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"const": "effect-in-flight"}}},
      "then": {
        "properties": {
          "attempt_count": {"type": "integer", "minimum": 1},
          "intent_ref": {"$ref": "#/$defs/reference"},
          "start_ref": {"$ref": "#/$defs/reference"},
          "settlement_ref": {"type": "null"},
          "result_ref": {"type": "null"},
          "state_commit_ref": {"type": "null"},
          "reconciliation_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"const": "outcome-unknown"}}},
      "then": {
        "properties": {
          "attempt_count": {"type": "integer", "minimum": 1},
          "intent_ref": {"$ref": "#/$defs/reference"},
          "start_ref": {"$ref": "#/$defs/reference"},
          "settlement_ref": {"type": "null"},
          "result_ref": {"type": "null"},
          "state_commit_ref": {"type": "null"},
          "reconciliation_reason": {"$ref": "#/$defs/reference"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"const": "effect-settled"}}},
      "then": {
        "properties": {
          "attempt_count": {"type": "integer", "minimum": 1},
          "intent_ref": {"$ref": "#/$defs/reference"},
          "start_ref": {"$ref": "#/$defs/reference"},
          "settlement_ref": {"$ref": "#/$defs/reference"},
          "result_ref": {"$ref": "#/$defs/reference"},
          "state_commit_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"enum": ["response-committed", "terminal"]}}},
      "then": {
        "properties": {
          "attempt_count": {"type": "integer", "minimum": 1},
          "intent_ref": {"$ref": "#/$defs/reference"},
          "start_ref": {"$ref": "#/$defs/reference"},
          "settlement_ref": {"$ref": "#/$defs/reference"},
          "result_ref": {"$ref": "#/$defs/reference"},
          "state_commit_ref": {"$ref": "#/$defs/reference"}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"const": "quarantined"}}},
      "then": {
        "properties": {
          "reconciliation_reason": {"$ref": "#/$defs/reference"}
        }
      }
    },
    {
      "if": {"properties": {"effect": {"properties": {"replay_policy": {"const": "safe"}}}}},
      "then": {"properties": {"effect": {"properties": {"idempotency_mode": {"const": "effect-key"}}}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "reference": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n\\u0000]+$"},
    "nullableReference": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
    "eventHead": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence_no", "event_sha256"],
      "properties": {
        "sequence_no": {"$ref": "#/$defs/nonNegativeInteger"},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["project_revision", "event_head"],
      "properties": {
        "project_revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "event_head": {"$ref": "#/$defs/eventHead"}
      }
    },
    "scopeRef": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {"enum": ["repo", "directory", "file", "symbol", "capability", "effect"]},
        "scope_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_id", "effect_key", "operation", "scope_ref", "adapter_id", "request_sha256", "replay_policy", "idempotency_mode", "status_lookup"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/id"},
        "effect_key": {"$ref": "#/$defs/id"},
        "operation": {"$ref": "#/$defs/id"},
        "scope_ref": {"$ref": "#/$defs/scopeRef"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "replay_policy": {"enum": ["safe", "never"]},
        "idempotency_mode": {"enum": ["effect-key", "none"]},
        "status_lookup": {"enum": ["none", "supported", "required"]}
      }
    },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "digest_algorithm", "digest", "size_bytes", "artifact_uri"],
      "properties": {
        "schema_version": {"const": "context.artifact-ref/v1alpha1"},
        "digest_algorithm": {"const": "sha-256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "artifact_uri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"}
      }
    },
    "traceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "span_id", "run_id", "correlation_id"],
      "properties": {
        "trace_id": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
        "run_id": {"$ref": "#/$defs/id"},
        "correlation_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
