{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-01/durable-state-receipt.schema.json",
  "title": "Context Control Plane Durable State Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "action", "project_id", "work_id", "claim_id", "effect_id", "effect_key", "request_id", "request_sha256", "effect_status", "revision", "event_head", "result_ref", "registry_digest", "state_response_sha256", "reconciled", "state_write_authority", "provider_native_authority", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.durable-state-receipt/v1alpha1"},
    "operation_id": {"$ref": "#/$defs/id"},
    "action": {"enum": ["authorize", "complete"]},
    "project_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "claim_id": {"$ref": "#/$defs/id"},
    "effect_id": {"$ref": "#/$defs/id"},
    "effect_key": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "effect_status": {"enum": ["authorized", "started", "succeeded"]},
    "revision": {"type": "integer", "minimum": 0},
    "event_head": {"$ref": "#/$defs/eventHead"},
    "result_ref": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
    "registry_digest": {"$ref": "#/$defs/sha256"},
    "state_response_sha256": {"$ref": "#/$defs/sha256"},
    "reconciled": {"type": "boolean"},
    "state_write_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"effect_status": {"enum": ["authorized", "started"]}}}, "then": {"properties": {"result_ref": {"type": "null"}}}},
    {"if": {"properties": {"effect_status": {"const": "succeeded"}}}, "then": {"properties": {"result_ref": {"$ref": "#/$defs/reference"}}}},
    {"if": {"properties": {"action": {"const": "complete"}}}, "then": {"properties": {"effect_status": {"const": "succeeded"}, "result_ref": {"$ref": "#/$defs/reference"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n\\u0000]+$"},
    "eventHead": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence_no", "event_sha256"],
      "properties": {"sequence_no": {"type": "integer", "minimum": 1}, "event_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
