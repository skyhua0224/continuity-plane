{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-01/durable-effect-adapter.schema.json",
  "title": "Context Control Plane Durable Effect Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "adapter_version", "implementation_sha256", "source_ref", "idempotency_modes", "status_lookups", "replay_policies", "state_write_authority", "provider_native_authority"],
  "properties": {
    "schema_version": {"const": "context.durable-effect-adapter/v1alpha1"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "adapter_version": {"$ref": "#/$defs/semver"},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "source_ref": {"$ref": "#/$defs/reference"},
    "idempotency_modes": {"oneOf": [
      {"const": ["effect-key"]},
      {"const": ["none"]},
      {"const": ["effect-key", "none"]}
    ]},
    "status_lookups": {"oneOf": [
      {"const": ["none"]},
      {"const": ["required"]},
      {"const": ["supported"]},
      {"const": ["none", "required"]},
      {"const": ["none", "supported"]},
      {"const": ["required", "supported"]},
      {"const": ["none", "required", "supported"]}
    ]},
    "replay_policies": {"oneOf": [
      {"const": ["never"]},
      {"const": ["safe"]},
      {"const": ["never", "safe"]}
    ]},
    "state_write_authority": {"const": false},
    "provider_native_authority": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$"}
  }
}
