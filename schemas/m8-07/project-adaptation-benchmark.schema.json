{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.project-adaptation-benchmark/v1alpha1",
  "title": "M8-07 ProjectAdaptation benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "generated_at", "samples", "replay_attempts", "deterministic_replays", "activation_attempts", "successful_activations", "unauthorized_activation_attempts", "unauthorized_activation_rejections", "rollback_attempts", "rollback_veto_recoveries", "reset_attempts", "resets", "rates", "latency_ms", "thresholds", "authority_mutations", "provider_invocations", "external_services", "provenance", "verdict", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.project-adaptation-benchmark/v1alpha1"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark-m8-07-[0-9a-f]{24}$"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "samples": {"type": "integer", "minimum": 1},
    "replay_attempts": {"type": "integer", "minimum": 1},
    "deterministic_replays": {"type": "integer", "minimum": 0},
    "activation_attempts": {"type": "integer", "minimum": 1},
    "successful_activations": {"type": "integer", "minimum": 0},
    "unauthorized_activation_attempts": {"type": "integer", "minimum": 1},
    "unauthorized_activation_rejections": {"type": "integer", "minimum": 0},
    "rollback_attempts": {"type": "integer", "minimum": 1},
    "rollback_veto_recoveries": {"type": "integer", "minimum": 0},
    "reset_attempts": {"type": "integer", "minimum": 1},
    "resets": {"type": "integer", "minimum": 0},
    "rates": {"type": "object", "additionalProperties": false, "required": ["deterministic_replay_rate", "unauthorized_activation_rejection_rate", "rollback_veto_recovery_rate", "activation_success_rate", "reset_success_rate"], "properties": {"deterministic_replay_rate": {"type": "number", "minimum": 0, "maximum": 1}, "unauthorized_activation_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1}, "rollback_veto_recovery_rate": {"type": "number", "minimum": 0, "maximum": 1}, "activation_success_rate": {"type": "number", "minimum": 0, "maximum": 1}, "reset_success_rate": {"type": "number", "minimum": 0, "maximum": 1}}},
    "latency_ms": {"type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms", "max_ms"], "properties": {"p50_ms": {"type": "number", "exclusiveMinimum": 0}, "p95_ms": {"type": "number", "exclusiveMinimum": 0}, "max_ms": {"type": "number", "exclusiveMinimum": 0}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["deterministic_replay_rate_min", "unauthorized_activation_rejection_rate_min", "rollback_veto_recovery_rate_min", "activation_success_rate_min", "reset_success_rate_min", "authority_mutations_max", "latency_p95_ms_max"], "properties": {"deterministic_replay_rate_min": {"const": 1.0}, "unauthorized_activation_rejection_rate_min": {"const": 1.0}, "rollback_veto_recovery_rate_min": {"const": 1.0}, "activation_success_rate_min": {"const": 1.0}, "reset_success_rate_min": {"const": 1.0}, "authority_mutations_max": {"const": 0}, "latency_p95_ms_max": {"const": 50.0}}},
    "authority_mutations": {"const": 0},
    "provider_invocations": {"const": 0},
    "external_services": {"const": 0},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["implementation_sha256", "benchmark_sha256", "observation_schema_sha256", "proposal_schema_sha256", "replay_schema_sha256", "transition_schema_sha256"], "properties": {"implementation_sha256": {"$ref": "#/$defs/sha256"}, "benchmark_sha256": {"$ref": "#/$defs/sha256"}, "observation_schema_sha256": {"$ref": "#/$defs/sha256"}, "proposal_schema_sha256": {"$ref": "#/$defs/sha256"}, "replay_schema_sha256": {"$ref": "#/$defs/sha256"}, "transition_schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["decision", "failed_gates"], "properties": {"decision": {"enum": ["pass", "fail"]}, "failed_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
