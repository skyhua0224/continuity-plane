{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.project-adaptation-observation/v1alpha1",
  "title": "ProjectAdaptation verified observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "project_id", "profile_id", "run_ref", "state_revision", "verified", "metrics", "correction_refs", "failure_fixture_refs", "observed_at", "state_write_authority", "completion_authority", "provider_native_authority", "observation_sha256"],
  "properties": {
    "schema_version": {"const": "context.project-adaptation-observation/v1alpha1"},
    "observation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "profile_id": {"$ref": "#/$defs/id"},
    "run_ref": {"$ref": "#/$defs/id"},
    "state_revision": {"type": "integer", "minimum": 1},
    "verified": {"const": true},
    "metrics": {"$ref": "#/$defs/metrics"},
    "correction_refs": {"$ref": "#/$defs/strings"},
    "failure_fixture_refs": {"$ref": "#/$defs/strings"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "observation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["bytes_read", "bytes_emitted", "repeated_read_bytes", "verification_failures"], "properties": {"bytes_read": {"type": "integer", "minimum": 0}, "bytes_emitted": {"type": "integer", "minimum": 0}, "repeated_read_bytes": {"type": "integer", "minimum": 0}, "verification_failures": {"type": "integer", "minimum": 0}}}
  }
}
