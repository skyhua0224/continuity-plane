{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-06/reference-watch-decision.schema.json",
  "title": "Reference Watch Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "observation_id", "observation_sha256", "watch_id", "source_id", "source_identity_sha256", "watch_outcome", "assertion_status", "decision", "reason_code", "affected_assertion_ids", "stale_assertion_ids", "quarantined_assertion_ids", "superseded_assertion_ids", "completion_eligible_assertion_ids", "replacement_assertion_id", "replacement_record_sha256", "evaluated_at", "state_write_authority", "completion_authority", "provider_native_authority", "decision_sha256"],
  "properties": {
    "schema_version": {"const": "context.reference-watch-decision/v1alpha1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "observation_id": {"$ref": "#/$defs/id"},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "watch_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "source_identity_sha256": {"$ref": "#/$defs/sha256"},
    "watch_outcome": {"enum": ["unchanged", "changed", "unavailable", "expired"]},
    "assertion_status": {"enum": ["current", "stale", "quarantined"]},
    "decision": {"enum": ["allow-current", "reverify-required"]},
    "reason_code": {"enum": ["source-unchanged", "source-changed", "source-unavailable", "source-expired", "current-reverification"]},
    "affected_assertion_ids": {"$ref": "#/$defs/nonEmptyIdList"},
    "stale_assertion_ids": {"$ref": "#/$defs/idList"},
    "quarantined_assertion_ids": {"$ref": "#/$defs/idList"},
    "superseded_assertion_ids": {"$ref": "#/$defs/idList"},
    "completion_eligible_assertion_ids": {"$ref": "#/$defs/idList"},
    "replacement_assertion_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "replacement_record_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"reason_code": {"const": "source-unchanged"}}, "required": ["reason_code"]},
      "then": {"properties": {
        "watch_outcome": {"const": "unchanged"},
        "assertion_status": {"const": "current"},
        "decision": {"const": "allow-current"},
        "stale_assertion_ids": {"maxItems": 0},
        "quarantined_assertion_ids": {"maxItems": 0},
        "superseded_assertion_ids": {"maxItems": 0},
        "completion_eligible_assertion_ids": {"minItems": 1},
        "replacement_assertion_id": {"type": "null"},
        "replacement_record_sha256": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"reason_code": {"const": "source-changed"}}, "required": ["reason_code"]},
      "then": {"properties": {
        "watch_outcome": {"const": "changed"},
        "assertion_status": {"const": "stale"},
        "decision": {"const": "reverify-required"},
        "stale_assertion_ids": {"minItems": 1},
        "quarantined_assertion_ids": {"maxItems": 0},
        "superseded_assertion_ids": {"maxItems": 0},
        "completion_eligible_assertion_ids": {"maxItems": 0},
        "replacement_assertion_id": {"type": "null"},
        "replacement_record_sha256": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"reason_code": {"enum": ["source-unavailable", "source-expired"]}}, "required": ["reason_code"]},
      "then": {"properties": {
        "assertion_status": {"const": "quarantined"},
        "decision": {"const": "reverify-required"},
        "stale_assertion_ids": {"maxItems": 0},
        "quarantined_assertion_ids": {"minItems": 1},
        "superseded_assertion_ids": {"maxItems": 0},
        "completion_eligible_assertion_ids": {"maxItems": 0},
        "replacement_assertion_id": {"type": "null"},
        "replacement_record_sha256": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"reason_code": {"const": "source-unavailable"}}, "required": ["reason_code"]},
      "then": {"properties": {"watch_outcome": {"const": "unavailable"}}}
    },
    {
      "if": {"properties": {"reason_code": {"const": "source-expired"}}, "required": ["reason_code"]},
      "then": {"properties": {"watch_outcome": {"const": "expired"}}}
    },
    {
      "if": {"properties": {"reason_code": {"const": "current-reverification"}}, "required": ["reason_code"]},
      "then": {"properties": {
        "watch_outcome": {"const": "changed"},
        "assertion_status": {"const": "current"},
        "decision": {"const": "allow-current"},
        "stale_assertion_ids": {"minItems": 1},
        "quarantined_assertion_ids": {"maxItems": 0},
        "superseded_assertion_ids": {"minItems": 1},
        "completion_eligible_assertion_ids": {"minItems": 1},
        "replacement_assertion_id": {"$ref": "#/$defs/id"},
        "replacement_record_sha256": {"$ref": "#/$defs/sha256"}
      }}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idList": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonEmptyIdList": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
