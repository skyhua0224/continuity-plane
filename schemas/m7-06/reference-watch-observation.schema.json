{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m7-06/reference-watch-observation.schema.json",
  "title": "Reference Watch Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "watch_id", "watch_revision", "watch_sha256", "mode", "source_id", "source_ref", "source_identity_sha256", "authority_kind", "baseline_revision", "baseline_sha256", "availability_status", "observed_revision", "observed_sha256", "current_evidence_ref", "current_evidence_sha256", "valid_until", "trusted_at", "trusted_time_kind", "trusted_time_evidence_ref", "trusted_time_evidence_sha256", "trusted_time_verifier_id", "trusted_time_verifier_version", "trusted_time_trust_anchor_sha256", "trusted_time_registry_entry_sha256", "freshness_status", "watch_outcome", "affected_assertion_ids", "state_write_authority", "completion_authority", "provider_native_authority", "observation_sha256"],
  "properties": {
    "schema_version": {"const": "context.reference-watch-observation/v1alpha1"},
    "observation_id": {"$ref": "#/$defs/id"},
    "watch_id": {"$ref": "#/$defs/id"},
    "watch_revision": {"type": "integer", "minimum": 0},
    "watch_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"enum": ["live", "fixture"]},
    "source_id": {"$ref": "#/$defs/id"},
    "source_ref": {"$ref": "#/$defs/text"},
    "source_identity_sha256": {"$ref": "#/$defs/sha256"},
    "authority_kind": {"enum": ["current_code", "current_state", "industry_standard", "os_official", "software_official"]},
    "baseline_revision": {"$ref": "#/$defs/text"},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "availability_status": {"enum": ["available", "unavailable"]},
    "observed_revision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "observed_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "current_evidence_ref": {"$ref": "#/$defs/artifactRef"},
    "current_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "valid_until": {"type": "string", "format": "date-time"},
    "trusted_at": {"type": "string", "format": "date-time"},
    "trusted_time_kind": {"enum": ["state-mcp", "rfc3161", "provider-signed", "fixture-clock"]},
    "trusted_time_evidence_ref": {"$ref": "#/$defs/artifactRef"},
    "trusted_time_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_time_verifier_id": {"$ref": "#/$defs/id"},
    "trusted_time_verifier_version": {"$ref": "#/$defs/text"},
    "trusted_time_trust_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_time_registry_entry_sha256": {"$ref": "#/$defs/sha256"},
    "freshness_status": {"enum": ["current", "expired"]},
    "watch_outcome": {"enum": ["unchanged", "changed", "unavailable", "expired"]},
    "affected_assertion_ids": {"$ref": "#/$defs/idList"},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "observation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"availability_status": {"const": "available"}}, "required": ["availability_status"]}, "then": {"properties": {"observed_revision": {"$ref": "#/$defs/text"}, "observed_sha256": {"$ref": "#/$defs/sha256"}, "watch_outcome": {"enum": ["unchanged", "changed", "expired"]}}}},
    {"if": {"properties": {"availability_status": {"const": "unavailable"}}, "required": ["availability_status"]}, "then": {"properties": {"observed_revision": {"type": "null"}, "observed_sha256": {"type": "null"}, "watch_outcome": {"const": "unavailable"}}}},
    {"if": {"properties": {"watch_outcome": {"const": "unchanged"}}, "required": ["watch_outcome"]}, "then": {"properties": {"availability_status": {"const": "available"}, "freshness_status": {"const": "current"}}}},
    {"if": {"properties": {"watch_outcome": {"const": "changed"}}, "required": ["watch_outcome"]}, "then": {"properties": {"availability_status": {"const": "available"}}}},
    {"if": {"properties": {"watch_outcome": {"const": "expired"}}, "required": ["watch_outcome"]}, "then": {"properties": {"availability_status": {"const": "available"}, "freshness_status": {"const": "expired"}}}},
    {"if": {"properties": {"mode": {"const": "live"}}, "required": ["mode"]}, "then": {"properties": {"trusted_time_kind": {"enum": ["state-mcp", "rfc3161", "provider-signed"]}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n\\u0000]+$"},
    "artifactRef": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "idList": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
