{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m5-08/durable-continuation-recovery.schema.json",
  "title": "Context Control Plane Durable Continuation Recovery Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "project_id", "project_revision", "task_id",
    "task_revision", "event_head", "durable_state_sha256", "phase",
    "last_durable_action", "first_action", "acknowledged_input_ids",
    "reserved_effect_ids", "response_mode", "continuation_fields_total",
    "continuation_fields_recovered", "acknowledged_input_replays", "execution_gate",
    "recovery_read_receipt", "observed_at", "state_write_authority",
    "provider_native_authority", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.durable-continuation-recovery/v1alpha1"},
    "operation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"$ref": "#/$defs/nonNegativeInteger"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_revision": {"$ref": "#/$defs/nonNegativeInteger"},
    "event_head": {"$ref": "#/$defs/eventHead"},
    "durable_state_sha256": {"$ref": "#/$defs/sha256"},
    "phase": {
      "enum": [
        "prepared", "intent-committed", "effect-in-flight", "effect-settled",
        "response-committed", "terminal"
      ]
    },
    "last_durable_action": {"$ref": "#/$defs/action"},
    "first_action": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]},
    "acknowledged_input_ids": {"$ref": "#/$defs/idList"},
    "reserved_effect_ids": {"$ref": "#/$defs/idList"},
    "response_mode": {
      "enum": ["continue-silently", "answer-pending-input", "await-effect", "terminal"]
    },
    "continuation_fields_total": {"const": 10},
    "continuation_fields_recovered": {"const": 10},
    "acknowledged_input_replays": {"const": 0},
    "execution_gate": {"const": "allow"},
    "recovery_read_receipt": {"$ref": "#/$defs/recoveryReadReceipt"},
    "observed_at": {"type": "string", "format": "date-time"},
    "state_write_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "eventHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_no", "event_sha256"],
      "properties": {
        "sequence_no": {"$ref": "#/$defs/nonNegativeInteger"},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recoveryReadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_count", "bytes_read", "budget_bytes", "source_refs", "reads_sha256"],
      "properties": {
        "read_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "bytes_read": {"$ref": "#/$defs/nonNegativeInteger"},
        "budget_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "source_refs": {"$ref": "#/$defs/idList"},
        "reads_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
