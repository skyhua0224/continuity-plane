{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m5-08/durable-continuation.schema.json",
  "title": "Context Control Plane Durable Continuation State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "project_id", "project_revision", "task_id",
    "task_revision", "event_head", "phase", "last_durable_action", "next_action",
    "acknowledged_input_ids", "reserved_effects", "response_mode",
    "state_write_authority", "provider_native_authority", "state_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.durable-continuation/v1alpha1"},
    "operation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"$ref": "#/$defs/nonNegativeInteger"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_revision": {"$ref": "#/$defs/nonNegativeInteger"},
    "event_head": {"$ref": "#/$defs/eventHead"},
    "phase": {
      "enum": [
        "prepared", "intent-committed", "effect-in-flight", "effect-settled",
        "response-committed", "terminal"
      ]
    },
    "last_durable_action": {"$ref": "#/$defs/action"},
    "next_action": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]},
    "acknowledged_input_ids": {"$ref": "#/$defs/idList"},
    "reserved_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reservedEffect"}
    },
    "response_mode": {
      "enum": ["continue-silently", "answer-pending-input", "await-effect", "terminal"]
    },
    "state_write_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "state_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "terminal"}}, "required": ["phase"]},
      "then": {
        "properties": {
          "next_action": {"type": "null"},
          "response_mode": {"const": "terminal"}
        }
      },
      "else": {
        "properties": {
          "next_action": {"$ref": "#/$defs/action"},
          "response_mode": {
            "enum": ["continue-silently", "answer-pending-input", "await-effect"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "eventHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_no", "event_sha256"],
      "properties": {
        "sequence_no": {"$ref": "#/$defs/nonNegativeInteger"},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reservedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "replay_policy", "status"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/id"},
        "replay_policy": {"enum": ["safe", "never"]},
        "status": {"enum": ["reserved", "started", "settled"]}
      }
    }
  }
}
