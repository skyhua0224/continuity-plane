{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.continuity-plane.dev/context.light-observation/v1alpha1",
  "title": "Continuity Plane State MCP Observation",
  "type": "object",
  "required": [
    "schema_version",
    "event_type",
    "observed_at_utc",
    "session_sha256",
    "project_sha256",
    "policy_sha256",
    "preset",
    "success"
  ],
  "properties": {
    "schema_version": {"const": "context.light-observation/v1alpha1"},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "session_sha256": {"$ref": "#/$defs/sha256"},
    "project_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "preset": {"enum": ["balanced", "diagnostic", "reliability-first"]},
    "success": {"type": "boolean"},
    "duration_ms": {"type": "number", "minimum": 0},
    "observation_truncated": {"type": "boolean"},
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
    },
    "request_bytes": {"type": ["integer", "null"], "minimum": 0},
    "response_bytes": {"type": ["integer", "null"], "minimum": 0},
    "request_bytes_total": {"type": "integer", "minimum": 0},
    "response_bytes_total": {"type": "integer", "minimum": 0},
    "packet_bytes": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "cached_input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "reasoning_tokens": {"type": "integer", "minimum": 0},
    "measurement_source": {"enum": ["host", "plugin", "unavailable"]},
    "state_store_bytes": {"type": "integer", "minimum": 0},
    "session_log_bytes": {"type": "integer", "minimum": 0},
    "rss_bytes": {"type": "integer", "minimum": 0},
    "peak_rss_bytes": {"type": "integer", "minimum": 0},
    "read_calls": {"type": "integer", "minimum": 0},
    "write_calls": {"type": "integer", "minimum": 0},
    "failed_calls": {"type": "integer", "minimum": 0},
    "resume_calls": {"type": "integer", "minimum": 0},
    "duplicate_resumes": {"type": "integer", "minimum": 0},
    "latency_buckets": {
      "type": "string",
      "pattern": "^[0-9,]{1,128}$"
    },
    "observation_degraded": {"type": "boolean"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
