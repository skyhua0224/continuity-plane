{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.task-graph/v1alpha1",
  "title": "Context Control Plane task graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "state_revision", "root_ids", "nodes"],
  "properties": {
    "schema_version": {"const": "context.task-graph/v1alpha1"},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "state_revision": {"type": "integer", "minimum": 0},
    "root_ids": {
      "allOf": [
        {"$ref": "#/$defs/stringSet"},
        {"minItems": 1}
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "stringSet": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "work_revision",
        "kind",
        "title",
        "parent_id",
        "dependency_ids",
        "return_point_id",
        "exit_criteria",
        "attempt_budget",
        "expiry",
        "promotion_target_id",
        "mainline_authority"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_revision": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["campaign", "goal", "work", "experiment"]},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "parent_id": {"$ref": "#/$defs/nullableString"},
        "dependency_ids": {"$ref": "#/$defs/stringSet"},
        "return_point_id": {"$ref": "#/$defs/nullableString"},
        "exit_criteria": {"$ref": "#/$defs/stringSet"},
        "attempt_budget": {"type": ["integer", "null"], "minimum": 1},
        "expiry": {"type": ["string", "null"], "format": "date-time"},
        "promotion_target_id": {"$ref": "#/$defs/nullableString"},
        "mainline_authority": {"type": "boolean"}
      }
    }
  }
}
