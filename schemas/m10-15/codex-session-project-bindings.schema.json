{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.continuity-plane.dev/context.codex-session-project-bindings/v1alpha1",
  "title": "Continuity Plane Codex Session Project Bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_sha256",
    "active_project_root",
    "projects",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "context.codex-session-project-bindings/v1alpha1"
    },
    "session_sha256": {"$ref": "#/$defs/sha256"},
    "active_project_root": {"$ref": "#/$defs/path"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/project"}
    },
    "binding_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "project_root", "profile_sha256"],
      "properties": {
        "project_id": {"$ref": "#/$defs/id"},
        "project_root": {"$ref": "#/$defs/path"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
