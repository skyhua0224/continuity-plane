{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m5-07/continuation-obligation.schema.json",
  "title": "Context Control Plane continuation obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "obligation_id", "project_id", "campaign_id", "active_work_id", "project_revision", "governance_revision", "expected_action", "ready_work_ids", "typed_blocker_id", "observed_at", "evidence_refs", "state_write_authority", "completion_authority", "obligation_sha256"],
  "properties": {
    "schema_version": {"const": "context.continuation-obligation/v1alpha1"},
    "obligation_id": {"$ref": "#/$defs/text"},
    "project_id": {"$ref": "#/$defs/text"},
    "campaign_id": {"$ref": "#/$defs/text"},
    "active_work_id": {"$ref": "#/$defs/text"},
    "project_revision": {"type": "integer", "minimum": 0},
    "governance_revision": {"type": "integer", "minimum": 0},
    "expected_action": {"const": "continue"},
    "ready_work_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}, "contains": {"$ref": "#/$defs/text"}},
    "typed_blocker_id": {"type": "null"},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "obligation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": ".*\\S.*"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
