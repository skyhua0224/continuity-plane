{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.typed-state/v3alpha1",
  "title": "Context Control Plane typed state with Experiment lifecycle ledgers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "works",
    "claims",
    "ideas",
    "decisions",
    "constraints",
    "evidence",
    "blockers",
    "effects",
    "experiment_attempts",
    "experiment_promotions"
  ],
  "properties": {
    "schema_version": {"const": "context.typed-state/v3alpha1"},
    "project": {"$ref": "#/$defs/project"},
    "works": {"type": "array", "items": {"$ref": "#/$defs/work"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "ideas": {"type": "array", "items": {"$ref": "#/$defs/idea"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "experiment_attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "experiment_promotions": {"type": "array", "items": {"$ref": "#/$defs/promotion"}}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {
          "enum": ["repo", "directory", "file", "symbol", "capability", "effect"]
        },
        "scope_ref": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "scopeList": {
      "type": "array",
      "items": {"$ref": "#/$defs/scope"}
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "revision",
        "governance_ref",
        "active_work_ids",
        "primary_work_id",
        "current_decision_ids",
        "active_constraint_ids",
        "open_blocker_ids",
        "effect_high_watermark",
        "updated_at"
      ],
      "properties": {
        "project_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "governance_ref": {"$ref": "#/$defs/nonEmptyString"},
        "active_work_ids": {"$ref": "#/$defs/stringList"},
        "primary_work_id": {"$ref": "#/$defs/nullableString"},
        "current_decision_ids": {"$ref": "#/$defs/stringList"},
        "active_constraint_ids": {"$ref": "#/$defs/stringList"},
        "open_blocker_ids": {"$ref": "#/$defs/stringList"},
        "effect_high_watermark": {"$ref": "#/$defs/nonNegativeInteger"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "kind",
        "title",
        "status",
        "parent_work_id",
        "dependency_ids",
        "owner_refs",
        "scope_refs",
        "overlap_candidate_ids",
        "dedupe_status",
        "supersedes_work_id",
        "evidence_ids",
        "blocker_ids",
        "revision",
        "return_point_work_id",
        "exit_criteria",
        "attempt_budget",
        "expires_at",
        "promotion_target_work_id",
        "mainline_authority"
      ],
      "properties": {
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"enum": ["campaign", "goal", "work", "experiment"]},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "status": {
          "enum": [
            "proposed",
            "blocked",
            "ready",
            "active",
            "verifying",
            "completed",
            "rejected",
            "reverted",
            "superseded"
          ]
        },
        "parent_work_id": {"$ref": "#/$defs/nullableString"},
        "dependency_ids": {"$ref": "#/$defs/stringList"},
        "owner_refs": {"$ref": "#/$defs/stringList"},
        "scope_refs": {"$ref": "#/$defs/scopeList"},
        "overlap_candidate_ids": {"$ref": "#/$defs/stringList"},
        "dedupe_status": {"enum": ["clear", "candidate", "blocked", "coordinated"]},
        "supersedes_work_id": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"$ref": "#/$defs/stringList"},
        "blocker_ids": {"$ref": "#/$defs/stringList"},
        "revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "return_point_work_id": {"$ref": "#/$defs/nullableString"},
        "exit_criteria": {"$ref": "#/$defs/stringList"},
        "attempt_budget": {"$ref": "#/$defs/nullablePositiveInteger"},
        "expires_at": {"$ref": "#/$defs/nullableString"},
        "promotion_target_work_id": {"$ref": "#/$defs/nullableString"},
        "mainline_authority": {"type": "boolean"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "work_id",
        "actor_ref",
        "status",
        "expected_project_revision",
        "claimed_at",
        "lease_expires_at",
        "released_at",
        "scope_owners"
      ],
      "properties": {
        "claim_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "actor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["active", "released", "expired", "revoked"]},
        "expected_project_revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "claimed_at": {"$ref": "#/$defs/timestamp"},
        "lease_expires_at": {"$ref": "#/$defs/timestamp"},
        "released_at": {"$ref": "#/$defs/nullableString"},
        "scope_owners": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scope"}
        }
      }
    },
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idea_id",
        "parent_work_id",
        "source_ref",
        "summary",
        "status",
        "return_work_id",
        "expiry",
        "attempt_budget",
        "promotion_target",
        "evidence_ids"
      ],
      "properties": {
        "idea_id": {"$ref": "#/$defs/nonEmptyString"},
        "parent_work_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "status": {
          "enum": ["candidate", "parked", "proposed", "approved", "rejected", "superseded"]
        },
        "return_work_id": {"$ref": "#/$defs/nonEmptyString"},
        "expiry": {"$ref": "#/$defs/nullableString"},
        "attempt_budget": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "promotion_target": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "work_id",
        "status",
        "statement",
        "decided_at",
        "supersedes_decision_id",
        "evidence_ids"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {
          "enum": ["proposed", "accepted", "rejected", "reverted", "superseded"]
        },
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "decided_at": {"$ref": "#/$defs/timestamp"},
        "supersedes_decision_id": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "status",
        "statement",
        "scope_work_ids",
        "expires_at",
        "supersedes_constraint_id",
        "evidence_ids"
      ],
      "properties": {
        "constraint_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {
          "enum": ["active", "satisfied", "expired", "rejected", "superseded"]
        },
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "scope_work_ids": {"$ref": "#/$defs/stringList"},
        "expires_at": {"$ref": "#/$defs/nullableString"},
        "supersedes_constraint_id": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "artifact_ref",
        "content_sha256",
        "validity",
        "observed_at",
        "verified_at"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {
          "enum": [
            "source-code",
            "standard",
            "os-official",
            "software-official",
            "test",
            "artifact",
            "user-decision"
          ]
        },
        "artifact_ref": {"$ref": "#/$defs/nonEmptyString"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "validity": {"enum": ["candidate", "verified", "stale", "rejected"]},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "verified_at": {"$ref": "#/$defs/nullableString"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "status",
        "reason",
        "blocked_work_ids",
        "evidence_ids",
        "opened_at",
        "resolved_at",
        "supersedes_blocker_id"
      ],
      "properties": {
        "blocker_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["open", "resolved", "superseded"]},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "blocked_work_ids": {"$ref": "#/$defs/stringList"},
        "evidence_ids": {"$ref": "#/$defs/stringList"},
        "opened_at": {"$ref": "#/$defs/timestamp"},
        "resolved_at": {"$ref": "#/$defs/nullableString"},
        "supersedes_blocker_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "effect_key",
        "work_id",
        "claim_id",
        "status",
        "operation",
        "scope_ref",
        "expected_project_revision",
        "sequence_no",
        "evidence_ids",
        "result_ref",
        "requested_at",
        "completed_at",
        "attempt_id"
      ],
      "properties": {
        "effect_id": {"$ref": "#/$defs/nonEmptyString"},
        "effect_key": {"$ref": "#/$defs/nonEmptyString"},
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "claim_id": {"$ref": "#/$defs/nullableString"},
        "status": {
          "enum": ["planned", "authorized", "started", "succeeded", "failed", "compensated"]
        },
        "operation": {"$ref": "#/$defs/nonEmptyString"},
        "scope_ref": {"$ref": "#/$defs/scope"},
        "expected_project_revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "sequence_no": {"type": "integer", "minimum": 1},
        "evidence_ids": {"$ref": "#/$defs/stringList"},
        "result_ref": {"$ref": "#/$defs/nullableString"},
        "requested_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/nullableString"},
        "attempt_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "work_id",
        "claim_id",
        "actor_ref",
        "attempt_no",
        "experiment_contract_sha256",
        "started_at"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "claim_id": {"$ref": "#/$defs/nonEmptyString"},
        "actor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "attempt_no": {"type": "integer", "minimum": 1},
        "experiment_contract_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_id",
        "kind",
        "proposal_id",
        "work_id",
        "target_work_id",
        "actor_ref",
        "source_work_revision",
        "target_work_revision",
        "attempt_id",
        "experiment_contract_sha256",
        "criterion_evidence",
        "created_at"
      ],
      "properties": {
        "promotion_id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"enum": ["proposed", "approved"]},
        "proposal_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_id": {"$ref": "#/$defs/nonEmptyString"},
        "target_work_id": {"$ref": "#/$defs/nonEmptyString"},
        "actor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "source_work_revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "target_work_revision": {"$ref": "#/$defs/nonNegativeInteger"},
        "attempt_id": {"$ref": "#/$defs/nonEmptyString"},
        "experiment_contract_sha256": {"$ref": "#/$defs/sha256"},
        "criterion_evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/nonEmptyString"},
            "uniqueItems": true
          }
        },
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "nullableNonNegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullablePositiveInteger": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
