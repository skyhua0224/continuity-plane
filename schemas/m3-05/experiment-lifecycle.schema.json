{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schema/context.experiment-lifecycle/v1alpha1",
  "title": "Context Control Plane Experiment lifecycle requests",
  "type": "object",
  "unevaluatedProperties": false,
  "oneOf": [
    {"$ref": "#/$defs/attempt"},
    {"$ref": "#/$defs/effect"},
    {"$ref": "#/$defs/proposal"},
    {"$ref": "#/$defs/approval"}
  ],
  "$defs": {
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {"enum": ["repo", "directory", "file", "symbol", "capability", "effect"]},
        "scope_ref": {"type": "string", "minLength": 1}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "attempt_id", "work_id", "claim_id", "causation_ref", "correlation_ref"],
      "properties": {
        "schema_version": {"const": "context.experiment-attempt-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "causation_ref": {"$ref": "#/$defs/nullableString"},
        "correlation_ref": {"$ref": "#/$defs/nullableString"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "action", "effect_id", "effect_key", "work_id", "claim_id", "attempt_id", "operation", "scope_ref", "result_ref", "evidence_ids", "causation_ref", "correlation_ref"],
      "properties": {
        "schema_version": {"const": "context.experiment-effect-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "action": {"enum": ["authorize", "complete"]},
        "effect_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "effect_key": {"type": "string", "minLength": 1, "maxLength": 300},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "operation": {"type": "string", "minLength": 1, "maxLength": 300},
        "scope_ref": {"$ref": "#/$defs/scope"},
        "result_ref": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "causation_ref": {"$ref": "#/$defs/nullableString"},
        "correlation_ref": {"$ref": "#/$defs/nullableString"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "authorize"}}},
          "then": {"properties": {"result_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"action": {"const": "complete"}}},
          "then": {"properties": {"result_ref": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "work_id", "expected_work_revision", "expected_target_work_revision", "attempt_id", "proposal_id", "criterion_evidence", "causation_ref", "correlation_ref"],
      "properties": {
        "schema_version": {"const": "context.experiment-promotion-proposal-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_work_revision": {"type": "integer", "minimum": 0},
        "expected_target_work_revision": {"type": "integer", "minimum": 0},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "proposal_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "criterion_evidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "causation_ref": {"$ref": "#/$defs/nullableString"},
        "correlation_ref": {"$ref": "#/$defs/nullableString"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "expected_revision", "work_id", "expected_work_revision", "expected_target_work_revision", "proposal_id", "approval_id", "causation_ref", "correlation_ref"],
      "properties": {
        "schema_version": {"const": "context.experiment-promotion-approval-request/v1alpha1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_work_revision": {"type": "integer", "minimum": 0},
        "expected_target_work_revision": {"type": "integer", "minimum": 0},
        "proposal_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "approval_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "causation_ref": {"$ref": "#/$defs/nullableString"},
        "correlation_ref": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}
