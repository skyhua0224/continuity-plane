{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.invalid/schemas/m8-10/collaboration-subscription-request.schema.json",
  "title": "M8-10 collaboration subscription request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "subscription_id", "tenant_id", "project_id", "provider", "transport", "event_kinds"],
  "properties": {
    "schema_version": {"const": "context.collaboration-subscription-request/v1alpha1"},
    "request_id": {"$ref": "#/$defs/id"},
    "subscription_id": {"$ref": "#/$defs/id"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "provider": {"$ref": "#/$defs/id"},
    "transport": {"enum": ["sse", "websocket"]},
    "event_kinds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["approval_requested", "conflict_detected", "deploy_intent", "review_requested", "work_claimed"]}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}}
}
