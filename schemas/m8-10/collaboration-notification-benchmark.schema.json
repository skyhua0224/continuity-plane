{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m8-10/collaboration-notification-benchmark.schema.json",
  "title": "M8-10 collaboration notification benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "generated_at", "event_count", "campaign_steps", "providers", "publish_attempts", "published_events", "dual_session_delivery_attempts", "consistent_dual_session_events", "offline_catch_up_attempts", "offline_catch_up_deliveries", "duplicate_attempts", "duplicate_suppressions", "signed_event_validation_attempts", "signed_event_validations", "same_revision_delivery_attempts", "same_revision_deliveries", "deterministic_sse_matches", "rates", "latency_ms", "thresholds", "authority_violations", "provider_invocations", "external_services", "campaign_scale", "provenance", "verdict", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "context.collaboration-notification-benchmark/v1alpha1"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark-m8-10-[0-9a-f]{24}$"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "campaign_steps": {"type": "integer", "minimum": 1, "maximum": 1000},
    "providers": {"const": ["codex", "claude"]},
    "publish_attempts": {"type": "integer", "minimum": 1},
    "published_events": {"type": "integer", "minimum": 0},
    "dual_session_delivery_attempts": {"type": "integer", "minimum": 1},
    "consistent_dual_session_events": {"type": "integer", "minimum": 0},
    "offline_catch_up_attempts": {"type": "integer", "minimum": 1},
    "offline_catch_up_deliveries": {"type": "integer", "minimum": 0},
    "duplicate_attempts": {"type": "integer", "minimum": 1},
    "duplicate_suppressions": {"type": "integer", "minimum": 0},
    "signed_event_validation_attempts": {"type": "integer", "minimum": 1},
    "signed_event_validations": {"type": "integer", "minimum": 0},
    "same_revision_delivery_attempts": {"type": "integer", "minimum": 1},
    "same_revision_deliveries": {"type": "integer", "minimum": 0},
    "deterministic_sse_matches": {"const": 1},
    "rates": {"$ref": "#/$defs/rates"},
    "latency_ms": {"$ref": "#/$defs/latency"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "authority_violations": {"type": "integer", "minimum": 0},
    "provider_invocations": {"const": 0},
    "external_services": {"const": 0},
    "campaign_scale": {"$ref": "#/$defs/campaignScale"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "verdict": {"$ref": "#/$defs/verdict"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "latencySummary": {"type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms", "max_ms"], "properties": {"p50_ms": {"type": "number", "minimum": 0}, "p95_ms": {"type": "number", "minimum": 0}, "max_ms": {"type": "number", "minimum": 0}}},
    "rates": {"type": "object", "additionalProperties": false, "required": ["publish_rate", "dual_session_match_rate", "offline_catch_up_rate", "duplicate_suppression_rate", "signed_event_validation_rate", "same_revision_delivery_rate"], "properties": {"publish_rate": {"$ref": "#/$defs/rate"}, "dual_session_match_rate": {"$ref": "#/$defs/rate"}, "offline_catch_up_rate": {"$ref": "#/$defs/rate"}, "duplicate_suppression_rate": {"$ref": "#/$defs/rate"}, "signed_event_validation_rate": {"$ref": "#/$defs/rate"}, "same_revision_delivery_rate": {"$ref": "#/$defs/rate"}}},
    "latency": {"type": "object", "additionalProperties": false, "required": ["publish", "catch_up_total_ms"], "properties": {"publish": {"$ref": "#/$defs/latencySummary"}, "catch_up_total_ms": {"type": "number", "minimum": 0}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["publish_rate_min", "dual_session_match_rate_min", "offline_catch_up_rate_min", "duplicate_suppression_rate_min", "signed_event_validation_rate_min", "same_revision_delivery_rate_min", "authority_violations_max", "publish_latency_p95_ms_max", "catch_up_latency_ms_max"], "properties": {"publish_rate_min": {"const": 1.0}, "dual_session_match_rate_min": {"const": 1.0}, "offline_catch_up_rate_min": {"const": 1.0}, "duplicate_suppression_rate_min": {"const": 1.0}, "signed_event_validation_rate_min": {"const": 1.0}, "same_revision_delivery_rate_min": {"const": 1.0}, "authority_violations_max": {"const": 0}, "publish_latency_p95_ms_max": {"const": 50.0}, "catch_up_latency_ms_max": {"const": 2000.0}}},
    "campaignScale": {"type": "object", "additionalProperties": false, "required": ["steps", "validation_attempts", "expected_quadratic_attempts", "incremental_index_attempts", "validation_amplification", "projected_1000_step_validation_attempts", "observed_complexity", "adoption_decision", "target_stage", "latency_ms"], "properties": {"steps": {"type": "integer", "minimum": 1, "maximum": 1000}, "validation_attempts": {"type": "integer", "minimum": 1}, "expected_quadratic_attempts": {"type": "integer", "minimum": 1}, "incremental_index_attempts": {"type": "integer", "minimum": 1}, "validation_amplification": {"type": "number", "minimum": 1}, "projected_1000_step_validation_attempts": {"const": 500500}, "observed_complexity": {"const": "quadratic"}, "adoption_decision": {"const": "adopt-append-only-step-index"}, "target_stage": {"const": "M10-production-pilot"}, "latency_ms": {"$ref": "#/$defs/latencySummary"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["implementation_sha256", "benchmark_sha256", "unattended_cursor_store_sha256", "notification_schema_sha256", "benchmark_schema_sha256"], "properties": {"implementation_sha256": {"$ref": "#/$defs/sha256"}, "benchmark_sha256": {"$ref": "#/$defs/sha256"}, "unattended_cursor_store_sha256": {"$ref": "#/$defs/sha256"}, "notification_schema_sha256": {"$ref": "#/$defs/sha256"}, "benchmark_schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["decision", "failed_gates"], "properties": {"decision": {"enum": ["pass", "fail"]}, "failed_gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["publish", "dual-session", "offline-catch-up", "duplicate-suppression", "signed-event", "same-revision", "authority", "publish-latency", "catch-up-latency", "campaign-scale"]}}}}
  }
}
