{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.invalid/schemas/m8-10/agent-inbox-item.schema.json",
  "title": "M8-10 display-only Agent inbox item",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_kind", "summary", "work_id", "evidence_refs", "requires_approval", "display_allowed", "approval_submission_allowed", "context_injection_allowed", "operation_allowed", "state_write_authority"],
  "properties": {
    "event_id": {"$ref": "#/$defs/id"},
    "event_kind": {"enum": ["approval_requested", "conflict_detected", "deploy_intent", "review_requested", "work_claimed"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\r\\n\\u0000]+$"},
    "work_id": {"$ref": "#/$defs/id"},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "requires_approval": {"type": "boolean"},
    "display_allowed": {"const": true},
    "approval_submission_allowed": {"const": false},
    "context_injection_allowed": {"const": false},
    "operation_allowed": {"const": false},
    "state_write_authority": {"const": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}}
}
