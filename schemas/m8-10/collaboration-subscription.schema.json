{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.invalid/schemas/m8-10/collaboration-subscription.schema.json",
  "title": "M8-10 signed collaboration subscription",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "subscription_id", "tenant_id", "project_id", "subscriber_ref", "provider", "transport", "event_kinds", "created_at", "websocket_available", "state_write_authority", "subscription_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "context.collaboration-subscription/v1alpha1"},
    "request_id": {"$ref": "#/$defs/id"},
    "subscription_id": {"$ref": "#/$defs/id"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "subscriber_ref": {"$ref": "#/$defs/id"},
    "provider": {"$ref": "#/$defs/id"},
    "transport": {"enum": ["sse", "websocket"]},
    "event_kinds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["approval_requested", "conflict_detected", "deploy_intent", "review_requested", "work_claimed"]}},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "websocket_available": {"type": "boolean"},
    "state_write_authority": {"const": false},
    "subscription_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "hmac-sha256"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/sha256"}}}
  }
}
