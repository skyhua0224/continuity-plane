{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-03/workflow-backend-binding.schema.json",
  "title": "Context Control Plane Workflow Backend Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "backend_id",
    "workflow_id",
    "chain_id",
    "run_id",
    "run_sha256",
    "authority_project_revision",
    "authority_event_head_sha256",
    "committed_project_revision",
    "state_mcp_receipt",
    "state_mcp_receipt_sha256",
    "status",
    "committed_at",
    "state_write_authority",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.workflow-backend-binding/v1alpha1"},
    "binding_id": {"$ref": "#/$defs/id"},
    "backend_id": {"const": "temporal"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "chain_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "run_sha256": {"$ref": "#/$defs/sha256"},
    "authority_project_revision": {"type": "integer", "minimum": 0},
    "authority_event_head_sha256": {"$ref": "#/$defs/sha256"},
    "committed_project_revision": {"type": "integer", "minimum": 1},
    "state_mcp_receipt": {"$ref": "#/$defs/dispatchReceipt"},
    "state_mcp_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "committed"},
    "committed_at": {"$ref": "#/$defs/timestamp"},
    "state_write_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {"const": "capability"},
        "scope_ref": {"const": "workflow-backend"}
      }
    },
    "dispatchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "project_revision",
        "work_id",
        "claim_id",
        "claim_revision",
        "lease_epoch",
        "fence",
        "effect_id",
        "effect_key",
        "request_sha256",
        "operation",
        "scope_ref",
        "dispatch_started_at",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "context.effect-dispatch-receipt/v1alpha1"},
        "request_id": {"$ref": "#/$defs/id"},
        "project_id": {"$ref": "#/$defs/id"},
        "project_revision": {"type": "integer", "minimum": 1},
        "work_id": {"$ref": "#/$defs/id"},
        "claim_id": {"$ref": "#/$defs/id"},
        "claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1},
        "effect_id": {"$ref": "#/$defs/id"},
        "effect_key": {"$ref": "#/$defs/id"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "operation": {"const": "workflow-backend-start"},
        "scope_ref": {"$ref": "#/$defs/scope"},
        "dispatch_started_at": {"$ref": "#/$defs/timestamp"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
