{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-03/workflow-adapter-manifest.schema.json",
  "title": "Context Control Plane Workflow Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend_id",
    "adapter_version",
    "implementation_sha256",
    "sdk_version",
    "namespace",
    "task_queue",
    "workflow_name",
    "execution_scope",
    "distributed_execution",
    "requires_sdk",
    "requires_service",
    "history_replay",
    "patching",
    "patch_contract",
    "worker_versioning_supported",
    "worker_versioning_configured",
    "worker_deployment",
    "worker_build_id",
    "continue_as_new",
    "state_write_authority",
    "claim_authority",
    "effect_authority",
    "effect_dispatch_authority",
    "provider_native_authority"
  ],
  "properties": {
    "schema_version": {"const": "context.workflow-adapter-manifest/v1alpha1"},
    "backend_id": {"const": "temporal"},
    "adapter_version": {"$ref": "#/$defs/id"},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "sdk_version": {"$ref": "#/$defs/id"},
    "namespace": {"$ref": "#/$defs/id"},
    "task_queue": {"$ref": "#/$defs/id"},
    "workflow_name": {"$ref": "#/$defs/id"},
    "execution_scope": {"const": "distributed"},
    "distributed_execution": {"const": true},
    "requires_sdk": {"const": true},
    "requires_service": {"const": true},
    "history_replay": {"const": true},
    "patching": {"const": true},
    "patch_contract": {"const": "temporal.workflow.patched"},
    "worker_versioning_supported": {"const": true},
    "worker_versioning_configured": {"type": "boolean"},
    "worker_deployment": {"$ref": "#/$defs/id"},
    "worker_build_id": {"$ref": "#/$defs/id"},
    "continue_as_new": {"const": true},
    "state_write_authority": {"const": false},
    "claim_authority": {"const": false},
    "effect_authority": {"const": false},
    "effect_dispatch_authority": {"const": false},
    "provider_native_authority": {"const": false}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
