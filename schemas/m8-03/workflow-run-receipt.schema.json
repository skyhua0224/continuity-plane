{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-03/workflow-run-receipt.schema.json",
  "title": "Context Control Plane Workflow Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "adapter_id",
    "adapter_version",
    "sdk_version",
    "namespace",
    "task_queue",
    "workflow_id",
    "chain_id",
    "core_run_id",
    "provider_run_id",
    "first_execution_run_id",
    "generation",
    "definition_version",
    "implementation_sha256",
    "worker_deployment",
    "worker_build_id",
    "worker_versioning_configured",
    "active_patch_ids",
    "run_sha256",
    "backend_binding_receipt_sha256",
    "backend_binding_committed",
    "state_write_authority",
    "effect_dispatch_authority",
    "provider_native_authority",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.workflow-run-receipt/v1alpha1"},
    "request_id": {"$ref": "#/$defs/id"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_id": {"const": "temporal"},
    "adapter_version": {"$ref": "#/$defs/id"},
    "sdk_version": {"$ref": "#/$defs/id"},
    "namespace": {"$ref": "#/$defs/id"},
    "task_queue": {"$ref": "#/$defs/id"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "chain_id": {"$ref": "#/$defs/id"},
    "core_run_id": {"$ref": "#/$defs/id"},
    "provider_run_id": {"$ref": "#/$defs/id"},
    "first_execution_run_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "definition_version": {"type": "integer", "minimum": 1},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "worker_deployment": {"$ref": "#/$defs/id"},
    "worker_build_id": {"$ref": "#/$defs/id"},
    "worker_versioning_configured": {"type": "boolean"},
    "active_patch_ids": {"$ref": "#/$defs/idSet"},
    "run_sha256": {"$ref": "#/$defs/sha256"},
    "backend_binding_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "backend_binding_committed": {"const": true},
    "state_write_authority": {"const": false},
    "effect_dispatch_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}
