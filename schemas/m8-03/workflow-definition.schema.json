{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m8-03/workflow-definition.schema.json",
  "title": "Context Control Plane Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_type",
    "definition_version",
    "implementation_sha256",
    "supported_history_versions",
    "patches",
    "state_write_authority",
    "effect_dispatch_authority",
    "provider_native_authority",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.workflow-definition/v1alpha1"},
    "workflow_type": {"$ref": "#/$defs/id"},
    "definition_version": {"type": "integer", "minimum": 1},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "supported_history_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "patches": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/patch"}
    },
    "state_write_authority": {"const": false},
    "effect_dispatch_authority": {"const": false},
    "provider_native_authority": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_id",
        "introduced_in_version",
        "deprecated_in_version",
        "semantic_sha256"
      ],
      "properties": {
        "patch_id": {"$ref": "#/$defs/id"},
        "introduced_in_version": {"type": "integer", "minimum": 1},
        "deprecated_in_version": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
