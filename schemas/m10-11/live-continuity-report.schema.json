{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity-plane.invalid/schemas/m10-11/live-continuity-report.schema.json",
  "title": "Derived live continuity matched comparison report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "observed_at", "segment_count", "segments_sha256", "matched_groups", "thresholds", "summary", "portability", "veto_failures", "gate_failures", "evidence_gaps", "verdict", "state_write_authority", "completion_authority", "report_sha256"],
  "properties": {
    "schema_version": {"const": "context.live-continuity-report/v1alpha1"},
    "report_id": {"$ref": "#/$defs/id"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "segment_count": {"type": "integer", "minimum": 1},
    "segments_sha256": {"$ref": "#/$defs/sha256"}, "matched_groups": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/group"}},
    "thresholds": {"$ref": "#/$defs/thresholds"}, "summary": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/summary"}]},
    "portability": {"$ref": "#/$defs/portability"},
    "veto_failures": {"$ref": "#/$defs/idList"}, "gate_failures": {"$ref": "#/$defs/idList"}, "evidence_gaps": {"$ref": "#/$defs/idList"},
    "verdict": {"enum": ["qualified", "failed", "insufficient-evidence"]}, "state_write_authority": {"const": false}, "completion_authority": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"}, "idList": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"$ref": "#/$defs/id"}},
    "group": {"type": "object", "additionalProperties": false, "required": ["match_sha256", "baseline", "candidate"], "properties": {"match_sha256": {"$ref": "#/$defs/sha256"}, "baseline": {"type": "integer", "minimum": 0}, "candidate": {"type": "integer", "minimum": 0}}},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_samples_per_arm", "input_tokens_per_work_reduction_percent", "output_tokens_per_work_reduction_percent", "total_tokens_per_work_reduction_percent", "accepted_work_per_compaction_improvement_percent", "useful_context_ratio_improvement_percent", "maximum_recovery_read_bytes", "direct_answer_rate"],
      "properties": {"minimum_samples_per_arm": {"const": 3}, "input_tokens_per_work_reduction_percent": {"const": 30.0}, "output_tokens_per_work_reduction_percent": {"const": 10.0}, "total_tokens_per_work_reduction_percent": {"const": 30.0}, "accepted_work_per_compaction_improvement_percent": {"const": 30.0}, "useful_context_ratio_improvement_percent": {"const": 30.0}, "maximum_recovery_read_bytes": {"const": 12288}, "direct_answer_rate": {"const": 1.0}}
    },
    "armMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["segments", "accepted_work", "compactions", "input_tokens_per_work", "output_tokens_per_work", "total_tokens_per_work", "accepted_work_per_compaction", "compaction_interval_minutes", "useful_context_ratio", "direct_answer_rate", "unwanted_table_count", "recovery_narration_count"],
      "properties": {"segments": {"type": "integer", "minimum": 1}, "accepted_work": {"type": "integer", "minimum": 1}, "compactions": {"type": "integer", "minimum": 1}, "input_tokens_per_work": {"type": "number", "minimum": 0}, "output_tokens_per_work": {"type": "number", "minimum": 0}, "total_tokens_per_work": {"type": "number", "minimum": 0}, "accepted_work_per_compaction": {"type": "number", "minimum": 0}, "compaction_interval_minutes": {"type": "number", "minimum": 0}, "useful_context_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "direct_answer_rate": {"type": "number", "minimum": 0, "maximum": 1}, "unwanted_table_count": {"type": "integer", "minimum": 0}, "recovery_narration_count": {"type": "integer", "minimum": 0}}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "candidate", "input_tokens_per_work_reduction_percent", "output_tokens_per_work_reduction_percent", "total_tokens_per_work_reduction_percent", "accepted_work_per_compaction_improvement_percent", "compaction_interval_improvement_percent", "useful_context_ratio_improvement_percent"],
      "properties": {"baseline": {"$ref": "#/$defs/armMetrics"}, "candidate": {"$ref": "#/$defs/armMetrics"}, "input_tokens_per_work_reduction_percent": {"type": "number"}, "output_tokens_per_work_reduction_percent": {"type": "number"}, "total_tokens_per_work_reduction_percent": {"type": "number"}, "accepted_work_per_compaction_improvement_percent": {"type": "number"}, "compaction_interval_improvement_percent": {"type": "number"}, "useful_context_ratio_improvement_percent": {"type": "number"}}
    },
    "portability": {
      "type": "object", "additionalProperties": false,
      "required": ["project_profiles", "provider_contracts", "collaboration_modes", "required_project_profiles", "required_provider_contracts", "required_collaboration_modes"],
      "properties": {"project_profiles": {"type": "integer", "minimum": 1}, "provider_contracts": {"type": "integer", "minimum": 1}, "collaboration_modes": {"type": "integer", "minimum": 1}, "required_project_profiles": {"type": "integer", "minimum": 1}, "required_provider_contracts": {"type": "integer", "minimum": 1}, "required_collaboration_modes": {"type": "integer", "minimum": 1}}
    }
  }
}
