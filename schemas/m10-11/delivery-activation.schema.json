{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.continuity-plane.dev/context.delivery-activation/v1alpha1",
  "title": "Continuity Plane delivery activation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "work_id",
    "source_ref",
    "predecessor_work_id",
    "implementation_evidence_ids",
    "workspace_verification",
    "allowed_effects",
    "source_evidence_id",
    "source_proposal_sha256",
    "state_write_authority",
    "completion_authority"
  ],
  "properties": {
    "schema_version": {"const": "context.delivery-activation/v1alpha1"},
    "project_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "source_ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]{1,960}$"},
    "predecessor_work_id": {"$ref": "#/$defs/id"},
    "implementation_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "workspace_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_commit",
        "clean",
        "worktree_delta_sha256",
        "expected_ref",
        "expected_ref_commit"
      ],
      "properties": {
        "workspace_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/id"}
          ]
        },
        "external_workspace": {"type": "boolean"},
        "repository_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "clean": {"type": "boolean"},
        "worktree_delta_sha256": {"$ref": "#/$defs/sha256"},
        "expected_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "expected_ref_commit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        }
      }
    },
    "allowed_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source-control.local",
          "source-control.history-rewrite",
          "source-control.push",
          "source-control.pr",
          "source-control.merge",
          "source-control.release",
          "deployment.deploy",
          "remote-effect.install-verification",
          "package-publish.publish"
        ]
      }
    },
    "source_evidence_id": {"$ref": "#/$defs/id"},
    "source_proposal_sha256": {"$ref": "#/$defs/sha256"},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
