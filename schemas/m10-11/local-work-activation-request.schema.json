{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.continuity-plane.dev/context.local-work-activation-request/v1alpha1",
  "title": "Continuity Plane Local Work Activation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "expected_revision",
    "work_id",
    "work_title",
    "owner_ref",
    "claim_id",
    "scope_owners",
    "source_evidence_id",
    "source_evidence",
    "source_proposal_sha256",
    "checkpoint_ref",
    "lease_expires_at",
    "causation_ref",
    "correlation_ref"
  ],
  "properties": {
    "schema_version": {"const": "context.local-work-activation-request/v1alpha1"},
    "request_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "work_id": {"$ref": "#/$defs/id"},
    "work_title": {"type": "string", "minLength": 1, "maxLength": 512},
    "owner_ref": {"$ref": "#/$defs/id"},
    "claim_id": {"$ref": "#/$defs/id"},
    "scope_owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope"}
    },
    "source_evidence_id": {"$ref": "#/$defs/id"},
    "source_evidence": {
      "anyOf": [
        {"$ref": "#/$defs/evidence"},
        {"type": "null"}
      ]
    },
    "source_proposal_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_ref": {"$ref": "#/$defs/artifactRef"},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "causation_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "correlation_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 500}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {"enum": ["repo", "directory", "file", "symbol", "capability", "effect"]},
        "scope_ref": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_uri", "digest_algorithm", "digest", "size_bytes"],
      "properties": {
        "schema_version": {"const": "context.artifact-ref/v1alpha1"},
        "artifact_uri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
        "digest_algorithm": {"const": "sha-256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "artifact_ref",
        "content_sha256",
        "validity",
        "observed_at",
        "verified_at"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "kind": {"const": "artifact"},
        "artifact_ref": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "validity": {"const": "verified"},
        "observed_at": {"type": "string", "format": "date-time"},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
