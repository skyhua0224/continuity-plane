{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-control-plane/m1-05/fault-coverage.schema.json",
  "x-schema-version": "context.fault-coverage/v1alpha1",
  "title": "Context Control Plane E0-E9 Fault Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "status", "evidence_refs", "fixtures"],
  "properties": {
    "schema_version": {"const": "context.fault-coverage/v1alpha1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "contract-verified-runtime-deferred"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "fixtures": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "string",
      "pattern": "^(artifact://|assertion:).+"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "claim_ref", "owner_ref", "paths"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "claim_ref": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_tasks", "state_revision", "effect_watermark", "claims"],
      "properties": {
        "active_tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "state_revision": {"type": "integer", "minimum": 0},
        "effect_watermark": {"type": "integer", "minimum": 0},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "active_tasks",
        "state_revision",
        "effect_watermark",
        "duplicate_effects",
        "unauthorized_effects",
        "stale_decisions_revived",
        "completion_claim"
      ],
      "properties": {
        "gate": {"enum": ["allow", "block", "read-only", "quarantine", "retry"]},
        "active_tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "state_revision": {"type": "integer", "minimum": 0},
        "effect_watermark": {"type": "integer", "minimum": 0},
        "duplicate_effects": {"const": 0},
        "unauthorized_effects": {"const": 0},
        "stale_decisions_revived": {"const": 0},
        "completion_claim": {"enum": ["pending", "accepted", "rejected"]}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "experiment_id",
        "scenario",
        "source_kind",
        "phase",
        "initial",
        "injection",
        "expected",
        "runtime_dependencies",
        "evidence_refs"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^fault-[a-z0-9-]+$"},
        "experiment_id": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9"]},
        "scenario": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["synthetic-contract", "admitted-replay"]},
        "phase": {"enum": ["contract", "runtime-verified"]},
        "initial": {"$ref": "#/$defs/state"},
        "injection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "boundary"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "boundary": {"type": "string", "minLength": 1}
          }
        },
        "expected": {"$ref": "#/$defs/expected"},
        "runtime_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M[0-9]+$"}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceRef"}
        }
      }
    }
  }
}
