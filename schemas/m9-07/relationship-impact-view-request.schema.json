{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m9-07/relationship-impact-view-request.schema.json",
  "title": "M9-07 Relationship and Impact view request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "expected_state_revision",
    "focus_node_ids",
    "direction",
    "max_depth",
    "relation_kinds",
    "node_kinds",
    "include_terminal_work",
    "max_nodes",
    "max_edges"
  ],
  "properties": {
    "schema_version": {"const": "context.relationship-impact-view-request/v1alpha1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "focus_node_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "direction": {"enum": ["incoming", "outgoing", "both"]},
    "max_depth": {"type": "integer", "minimum": 0, "maximum": 8},
    "relation_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "parent",
          "dependency",
          "supersedes",
          "return-point",
          "promotion-target",
          "references"
        ]
      }
    },
    "node_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["symbol", "work"]}
    },
    "include_terminal_work": {"type": "boolean"},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 2000},
    "max_edges": {"type": "integer", "minimum": 1, "maximum": 5000}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 2048}
  }
}
