{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m5-06/idea-return-checkpoint-binding.schema.json",
  "title": "Context Control Plane Idea Return Checkpoint Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_revision",
    "return_work_id",
    "return_work_revision",
    "canonical_plan_sha256",
    "registry_digest",
    "checkpoint_ref"
  ],
  "properties": {
    "schema_version": {"const": "context.idea-return-checkpoint-binding/v1alpha1"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"type": "integer", "minimum": 0},
    "return_work_id": {"$ref": "#/$defs/id"},
    "return_work_revision": {"type": "integer", "minimum": 0},
    "canonical_plan_sha256": {"$ref": "#/$defs/sha256"},
    "registry_digest": {"$ref": "#/$defs/sha256"},
    "checkpoint_ref": {"$ref": "#/$defs/artifact_ref"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "digest_algorithm",
        "digest",
        "size_bytes",
        "artifact_uri"
      ],
      "properties": {
        "schema_version": {"const": "context.artifact-ref/v1alpha1"},
        "digest_algorithm": {"const": "sha-256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "artifact_uri": {
          "type": "string",
          "pattern": "^artifact://sha256/[0-9a-f]{64}$"
        }
      }
    }
  }
}
