{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.dev/schemas/m5-06/idea-return-packet-benchmark.schema.json",
  "title": "Context Control Plane Idea Return Packet Benchmark Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "samples",
    "successful_samples",
    "replay_mismatch",
    "original_task_recovery_mismatch",
    "return_point_recovery_mismatch",
    "idea_ref_recovery_mismatch",
    "idea_body_copy_violations",
    "candidate_authority_violations",
    "fault_samples",
    "fault_rejections",
    "faults",
    "task_recovery_millionths",
    "return_point_recovery_millionths",
    "min_packet_bytes",
    "max_packet_bytes",
    "p50_ms",
    "p95_ms",
    "max_ms",
    "external_services",
    "implementation_sha256",
    "benchmark_sha256",
    "behavior_test_sha256",
    "benchmark_test_sha256",
    "return_packet_schema_sha256",
    "checkpoint_binding_schema_sha256",
    "migration_schema_sha256",
    "benchmark_schema_sha256",
    "fixture_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.idea-return-packet-benchmark/v1alpha1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "samples": {"type": "integer", "minimum": 1},
    "successful_samples": {"type": "integer", "minimum": 0},
    "replay_mismatch": {"type": "integer", "minimum": 0},
    "original_task_recovery_mismatch": {"type": "integer", "minimum": 0},
    "return_point_recovery_mismatch": {"type": "integer", "minimum": 0},
    "idea_ref_recovery_mismatch": {"type": "integer", "minimum": 0},
    "idea_body_copy_violations": {"type": "integer", "minimum": 0},
    "candidate_authority_violations": {"type": "integer", "minimum": 0},
    "fault_samples": {"type": "integer", "minimum": 0},
    "fault_rejections": {"type": "integer", "minimum": 0},
    "faults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canary_return_work",
        "checkpoint_binding",
        "current_active_work",
        "master_digest_drift",
        "registry_digest_drift",
        "return_revision"
      ],
      "properties": {
        "canary_return_work": {"type": "integer", "minimum": 0},
        "checkpoint_binding": {"type": "integer", "minimum": 0},
        "current_active_work": {"type": "integer", "minimum": 0},
        "master_digest_drift": {"type": "integer", "minimum": 0},
        "registry_digest_drift": {"type": "integer", "minimum": 0},
        "return_revision": {"type": "integer", "minimum": 0}
      }
    },
    "task_recovery_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "return_point_recovery_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "min_packet_bytes": {"type": "integer", "minimum": 1},
    "max_packet_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
    "p50_ms": {"type": "number", "minimum": 0},
    "p95_ms": {"type": "number", "minimum": 0},
    "max_ms": {"type": "number", "minimum": 0},
    "external_services": {"const": 0},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_sha256": {"$ref": "#/$defs/sha256"},
    "behavior_test_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_test_sha256": {"$ref": "#/$defs/sha256"},
    "return_packet_schema_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_binding_schema_sha256": {"$ref": "#/$defs/sha256"},
    "migration_schema_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_schema_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
