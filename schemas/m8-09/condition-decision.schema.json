{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m8-09/condition-decision.schema.json",
  "title": "M8-09 condition decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "condition_ref", "project_id", "project_revision", "profile_id", "governance_revision", "obligation_id", "obligation_revision", "outcome", "evidence_ids", "observed_at", "state_write_authority", "decision_sha256"],
  "properties": {
    "schema_version": {"const": "context.condition-decision/v1alpha1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "condition_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision": {"type": "integer", "minimum": 0},
    "profile_id": {"$ref": "#/$defs/id"},
    "governance_revision": {"type": "integer", "minimum": 1},
    "obligation_id": {"$ref": "#/$defs/id"},
    "obligation_revision": {"type": "integer", "minimum": 1},
    "outcome": {"enum": ["met", "not-met", "unknown"]},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "state_write_authority": {"const": false},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
