{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m8-09/unattended-dispatcher-benchmark.schema.json",
  "title": "M8-09 unattended dispatcher benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "benchmark_id", "generated_at", "samples",
    "required_work_per_sample", "optional_work_per_sample",
    "required_completion_attempts", "required_completions",
    "campaign_closure_attempts", "campaign_closures", "replay_attempts",
    "replay_matches", "duplicate_attempts",
    "duplicate_claim_execute_complete_rejections", "rates", "latency_ms",
    "thresholds", "authority_violations", "provider_invocations",
    "external_services", "provenance", "verdict", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "context.unattended-dispatcher-benchmark/v1alpha1"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark-m8-09-[0-9a-f]{24}$"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "samples": {"type": "integer", "minimum": 1},
    "required_work_per_sample": {"const": 3},
    "optional_work_per_sample": {"const": 1},
    "required_completion_attempts": {"type": "integer", "minimum": 1},
    "required_completions": {"type": "integer", "minimum": 0},
    "campaign_closure_attempts": {"type": "integer", "minimum": 1},
    "campaign_closures": {"type": "integer", "minimum": 0},
    "replay_attempts": {"type": "integer", "minimum": 1},
    "replay_matches": {"type": "integer", "minimum": 0},
    "duplicate_attempts": {"type": "integer", "minimum": 1},
    "duplicate_claim_execute_complete_rejections": {"type": "integer", "minimum": 0},
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_completion_rate", "campaign_closure_rate", "replay_match_rate", "duplicate_suppression_rate"],
      "properties": {
        "required_completion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "campaign_closure_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "replay_match_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "duplicate_suppression_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_ms", "p95_ms", "max_ms"],
      "properties": {
        "p50_ms": {"type": "number", "exclusiveMinimum": 0},
        "p95_ms": {"type": "number", "exclusiveMinimum": 0},
        "max_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_completion_rate_min", "campaign_closure_rate_min", "replay_match_rate_min", "duplicate_suppression_rate_min", "authority_violations_max", "latency_p95_ms_max"],
      "properties": {
        "required_completion_rate_min": {"const": 1.0},
        "campaign_closure_rate_min": {"const": 1.0},
        "replay_match_rate_min": {"const": 1.0},
        "duplicate_suppression_rate_min": {"const": 1.0},
        "authority_violations_max": {"const": 0},
        "latency_p95_ms_max": {"const": 50.0}
      }
    },
    "authority_violations": {"const": 0},
    "provider_invocations": {"const": 0},
    "external_services": {"const": 0},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256", "benchmark_sha256", "cursor_store_sha256", "receipt_validator_sha256", "state_mcp_sha256", "work_ledger_sha256"],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "cursor_store_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_validator_sha256": {"$ref": "#/$defs/sha256"},
        "state_mcp_sha256": {"$ref": "#/$defs/sha256"},
        "work_ledger_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "failed_gates"],
      "properties": {
        "decision": {"enum": ["pass", "fail"]},
        "failed_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
