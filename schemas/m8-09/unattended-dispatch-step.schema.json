{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m8-09/unattended-dispatch-step.schema.json",
  "title": "M8-09 unattended dispatch step",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_id", "project_revision_before", "project_revision_after", "profile_id", "governance_revision", "obligation_id", "work_id", "work_revision_before", "work_revision_after", "claim_id", "lease_epoch", "fence", "packet_sha256", "execution_sha256", "verification_decision_sha256", "claim_evidence_verdict_sha256", "completion_receipt_sha256", "evidence_ids", "condition_decision_sha256", "condition_evidence_ids", "state_write_authority", "completion_authority", "provider_authority", "external_effect_authority", "step_sha256"],
  "properties": {
    "schema_version": {"const": "context.unattended-dispatch-step/v1alpha1"},
    "status": {"const": "completed"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_revision_before": {"type": "integer", "minimum": 0},
    "project_revision_after": {"type": "integer", "minimum": 0},
    "profile_id": {"$ref": "#/$defs/id"},
    "governance_revision": {"type": "integer", "minimum": 1},
    "obligation_id": {"$ref": "#/$defs/id"},
    "work_id": {"$ref": "#/$defs/id"},
    "work_revision_before": {"type": "integer", "minimum": 1},
    "work_revision_after": {"type": "integer", "minimum": 1},
    "claim_id": {"$ref": "#/$defs/id"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "fence": {"type": "integer", "minimum": 1},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "execution_sha256": {"$ref": "#/$defs/sha256"},
    "verification_decision_sha256": {"$ref": "#/$defs/sha256"},
    "claim_evidence_verdict_sha256": {"$ref": "#/$defs/sha256"},
    "completion_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "condition_decision_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "condition_evidence_ids": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "state_write_authority": {"const": false},
    "completion_authority": {"const": false},
    "provider_authority": {"const": 0},
    "external_effect_authority": {"const": 0},
    "step_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
