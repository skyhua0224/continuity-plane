{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.dev/schema/context.state-mcp/v3alpha1",
  "title": "Continuity Plane Shared State MCP v3 Contract",
  "oneOf": [
    {"$ref": "#/$defs/acquire_request"},
    {"$ref": "#/$defs/heartbeat_request"},
    {"$ref": "#/$defs/release_request"},
    {"$ref": "#/$defs/revoke_request"},
    {"$ref": "#/$defs/expire_request"},
    {"$ref": "#/$defs/reclaim_request"},
    {"$ref": "#/$defs/effect_dispatch_request"},
    {"$ref": "#/$defs/success_response"},
    {"$ref": "#/$defs/error_response"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "non_negative_integer": {"type": "integer", "minimum": 0},
    "positive_integer": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": {
          "enum": ["capability", "directory", "effect", "file", "repo", "symbol"]
        },
        "scope_ref": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "scope_owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope_ref"}
    },
    "acquire_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "action",
        "expected_project_revision",
        "work_id",
        "claim_id",
        "requested_ttl_ms",
        "scope_owners"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "acquire"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "work_id": {"$ref": "#/$defs/identifier"},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "requested_ttl_ms": {"type": "integer", "minimum": 1},
        "scope_owners": {"$ref": "#/$defs/scope_owners"}
      }
    },
    "heartbeat_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "action",
        "expected_project_revision",
        "claim_id",
        "expected_claim_revision",
        "lease_epoch",
        "fence",
        "requested_ttl_ms"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "heartbeat"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "expected_claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1},
        "requested_ttl_ms": {"type": "integer", "minimum": 1}
      }
    },
    "release_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "action",
        "expected_project_revision",
        "claim_id",
        "expected_claim_revision",
        "lease_epoch",
        "fence"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "release"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "expected_claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1}
      }
    },
    "revoke_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "action",
        "expected_project_revision",
        "claim_id",
        "expected_claim_revision",
        "lease_epoch",
        "fence",
        "reason"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "revoke"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "expected_claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "expire_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "action",
        "expected_project_revision",
        "claim_id",
        "expected_claim_revision",
        "lease_epoch",
        "fence"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "expire"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "expected_claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1}
      }
    },
    "reclaim_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "action",
        "expected_project_revision",
        "old_claim_id",
        "new_claim_id",
        "expected_claim_revision",
        "lease_epoch",
        "fence",
        "requested_ttl_ms",
        "scope_owners"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "reclaim"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "old_claim_id": {"$ref": "#/$defs/identifier"},
        "new_claim_id": {"$ref": "#/$defs/identifier"},
        "expected_claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1},
        "requested_ttl_ms": {"type": "integer", "minimum": 1},
        "scope_owners": {"$ref": "#/$defs/scope_owners"}
      }
    },
    "effect_dispatch_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "project_id",
        "expected_project_revision",
        "expected_claim_revision",
        "lease_epoch",
        "fence",
        "effect_id",
        "effect_key",
        "request_sha256",
        "claim_id",
        "work_id",
        "operation",
        "scope_ref"
      ],
      "properties": {
        "schema_version": {"const": "context.state-mcp-request/v3alpha1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "expected_project_revision": {"type": "integer", "minimum": 0},
        "expected_claim_revision": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 1},
        "fence": {"type": "integer", "minimum": 1},
        "effect_id": {"$ref": "#/$defs/identifier"},
        "effect_key": {"$ref": "#/$defs/identifier"},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "work_id": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "scope_ref": {"$ref": "#/$defs/scope_ref"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 100},
        "reason": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "project_id", "project_revision_before", "project_revision_after", "actor_ref", "observed_at", "previous_transition_sha256", "changes", "transition_id", "transition_sha256"],
      "properties": {
        "schema_version": {"const": "context.work-claim-transition/v1alpha1"},
        "operation": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "project_revision_before": {"$ref": "#/$defs/non_negative_integer"},
        "project_revision_after": {"$ref": "#/$defs/non_negative_integer"},
        "actor_ref": {"$ref": "#/$defs/identifier"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "previous_transition_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "changes": {"type": "object"},
        "transition_id": {"$ref": "#/$defs/identifier"},
        "transition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "status", "project_revision", "claim", "receipt", "transition"],
      "properties": {
        "schema_version": {"const": "context.work-claim-receipt/v1alpha1"},
        "operation": {"$ref": "#/$defs/identifier"},
        "status": {"const": "accepted"},
        "project_revision": {"$ref": "#/$defs/non_negative_integer"},
        "claim": {"type": "object", "minProperties": 1},
        "receipt": {"type": "object", "required": ["receipt_sha256", "fence", "claim"], "properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}, "fence": {"$ref": "#/$defs/positive_integer"}, "claim": {"type": "object", "minProperties": 1}}},
        "transition": {"$ref": "#/$defs/transition"},
        "reclaimed_claim": {"type": "object", "minProperties": 1}
      }
    },
    "effect_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "status", "project_revision", "effect", "receipt", "transition"],
      "properties": {
        "schema_version": {"const": "context.effect-dispatch-receipt/v1alpha1"},
        "operation": {"const": "start-effect-dispatch"},
        "status": {"const": "accepted"},
        "project_revision": {"$ref": "#/$defs/non_negative_integer"},
        "effect": {"type": "object", "minProperties": 1},
        "receipt": {"type": "object", "required": ["receipt_sha256", "fence", "effect_id", "claim_id", "request_sha256"], "properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}, "fence": {"$ref": "#/$defs/positive_integer"}, "effect_id": {"$ref": "#/$defs/identifier"}, "claim_id": {"$ref": "#/$defs/identifier"}, "request_sha256": {"$ref": "#/$defs/sha256"}}},
        "transition": {"$ref": "#/$defs/transition"}
      }
    },
    "success_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "tool", "ok", "result", "error"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-response/v3alpha1"},
        "request_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "tool": {"enum": ["context.state.claim.lifecycle", "context.state.effect.dispatch"]},
        "ok": {"const": true},
        "result": {"oneOf": [{"$ref": "#/$defs/claim_result"}, {"$ref": "#/$defs/effect_result"}]},
        "error": {"type": "null"}
      }
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "tool", "ok", "result", "error"],
      "properties": {
        "schema_version": {"const": "context.state-mcp-response/v3alpha1"},
        "request_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "tool": {"type": "string", "minLength": 1, "maxLength": 256},
        "ok": {"const": false},
        "result": {"type": "null"},
        "error": {"$ref": "#/$defs/error"}
      }
    }
  }
}
