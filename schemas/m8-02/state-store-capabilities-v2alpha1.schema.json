{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-control-plane.invalid/schemas/m8-02/state-store-capabilities-v2alpha1.schema.json",
  "title": "State Store Capability Manifest v2alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "authority_mode",
    "operations",
    "shared_authority",
    "offline_write",
    "unique_claim_scope",
    "multi_writer",
    "lease_clock",
    "atomic_lease_transition",
    "fencing",
    "durable_request_receipts",
    "artifact_scope",
    "expected_revision",
    "migration_source",
    "migration_target"
  ],
  "properties": {
    "schema_version": {
      "const": "context.state-store-capabilities/v2alpha1"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "authority_mode": {
      "enum": ["local", "shared", "projection"]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create_project",
          "read_project",
          "read_events",
          "commit_event",
          "initialize_work_ledger",
          "execute_work_ledger",
          "read_work_ledger",
          "read_work_ledger_receipt"
        ]
      }
    },
    "shared_authority": {"type": "boolean"},
    "offline_write": {"type": "boolean"},
    "unique_claim_scope": {
      "enum": ["none", "authority-instance", "shared"]
    },
    "multi_writer": {"type": "boolean"},
    "lease_clock": {
      "enum": ["none", "process", "backend"]
    },
    "atomic_lease_transition": {"type": "boolean"},
    "fencing": {"type": "boolean"},
    "durable_request_receipts": {"type": "boolean"},
    "artifact_scope": {
      "enum": ["none", "local", "shared"]
    },
    "expected_revision": {"type": "boolean"},
    "migration_source": {"type": "boolean"},
    "migration_target": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"authority_mode": {"const": "shared"}}
      },
      "then": {
        "properties": {"shared_authority": {"const": true}}
      },
      "else": {
        "properties": {"shared_authority": {"const": false}}
      }
    },
    {
      "if": {
        "properties": {"authority_mode": {"const": "projection"}}
      },
      "then": {
        "properties": {
          "operations": {
            "not": {"contains": {"const": "commit_event"}}
          },
          "multi_writer": {"const": false},
          "unique_claim_scope": {"const": "none"},
          "atomic_lease_transition": {"const": false},
          "fencing": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {"unique_claim_scope": {"const": "none"}}
      },
      "then": {
        "properties": {
          "lease_clock": {"const": "none"},
          "atomic_lease_transition": {"const": false},
          "fencing": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {
          "unique_claim_scope": {"const": "authority-instance"}
        }
      },
      "then": {
        "properties": {
          "authority_mode": {"const": "local"},
          "shared_authority": {"const": false},
          "lease_clock": {"const": "process"},
          "atomic_lease_transition": {"const": true},
          "fencing": {"const": true},
          "expected_revision": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"unique_claim_scope": {"const": "shared"}}
      },
      "then": {
        "properties": {
          "authority_mode": {"const": "shared"},
          "shared_authority": {"const": true},
          "lease_clock": {"const": "backend"},
          "atomic_lease_transition": {"const": true},
          "fencing": {"const": true},
          "durable_request_receipts": {"const": true},
          "expected_revision": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"atomic_lease_transition": {"const": true}}
      },
      "then": {
        "properties": {"expected_revision": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {"fencing": {"const": true}}
      },
      "then": {
        "properties": {
          "atomic_lease_transition": {"const": true},
          "expected_revision": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operations": {"contains": {"const": "commit_event"}}
        }
      },
      "then": {
        "properties": {"expected_revision": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {"multi_writer": {"const": true}}
      },
      "then": {
        "properties": {"expected_revision": {"const": true}}
      }
    }
  ]
}
