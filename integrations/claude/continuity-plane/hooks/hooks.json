{
  "hooks": {
    "PostToolUse": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "SessionStart": [{"matcher": "startup|resume|compact", "hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "PreCompact": [{"matcher": "manual|auto", "hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "PostCompact": [{"matcher": "manual|auto", "hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "StopFailure": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "Notification": [{"matcher": "quota_auto_resume_disabled|quota_auto_resume_stale", "hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "continuity-host-hook", "timeout": 10}]}]
  }
}
