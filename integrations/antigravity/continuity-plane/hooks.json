{
  "continuity-plane": {
    "SessionStart": [
      {
        "type": "command",
        "command": "continuity-agy-hook",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "continuity-agy-hook",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "continuity-agy-hook",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "continuity-agy-hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "continuity-agy-hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
