{
  "description": "Continuity Plane bounded startup and compaction lifecycle.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "continuity-codex-hook \"${PLUGIN_ROOT}/scripts/continuity-hook.py\"",
            "commandWindows": "continuity-codex-hook \"%PLUGIN_ROOT%\\scripts\\continuity-hook.py\"",
            "timeout": 10,
            "statusMessage": "Loading bounded continuity state",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "continuity-codex-hook \"${PLUGIN_ROOT}/scripts/continuity-hook.py\"",
            "commandWindows": "continuity-codex-hook \"%PLUGIN_ROOT%\\scripts\\continuity-hook.py\"",
            "timeout": 10,
            "statusMessage": "Creating continuity checkpoint"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "continuity-codex-hook \"${PLUGIN_ROOT}/scripts/continuity-hook.py\"",
            "commandWindows": "continuity-codex-hook \"%PLUGIN_ROOT%\\scripts\\continuity-hook.py\"",
            "timeout": 10,
            "statusMessage": "Verifying continuity checkpoint"
          }
        ]
      }
    ]
  }
}
